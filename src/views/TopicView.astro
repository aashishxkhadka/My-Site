---
/** Topic hub at /blog/[key]/: written intro + every post in the topic. */
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import Layout from '@/designs/d4/Layout.astro';
import PageHeader from '@/designs/d4/components/PageHeader.astro';
import PostCard from '@/designs/d4/components/PostCard.astro';
import Faq from '@/designs/d4/components/Faq.astro';
import CtaPanel from '@/designs/d4/components/CtaPanel.astro';
import { byNewest } from '@/lib/content';
import { topicsInfo, type TopicInfo } from '@/lib/taxonomy';
import { itemListNode, faqNode } from '@/lib/schema';
import { postPath } from '@/lib/posts';

export interface Props {
  topic: TopicInfo;
  hub: CollectionEntry<'topics'>;
}
const { topic, hub } = Astro.props;
const { Content } = await render(hub);
const path = topic.href;
const posts = [...topic.posts].sort(byNewest);
const pillarIds = hub.data.pillars.map((p) => p.id);
const pillars = posts.filter((p) => pillarIds.includes(p.id));
const rest = posts.filter((p) => !pillarIds.includes(p.id));
const others = (await topicsInfo()).filter((t) => t.key !== topic.key && t.live);
const crumbs = [{ label: 'Blog', href: '/blog/' }, { label: topic.label, href: path }];
// Until a topic has TOPIC_MIN_POSTS posts the hub is thin: keep it out of the index.
const thin = !topic.live;
---

<Layout
  title={hub.data.title ?? topic.label}
  rawTitle={hub.data.seo.title}
  description={hub.data.description}
  noindex={hub.data.seo.noindex || thin}
  pageType="CollectionPage"
  breadcrumbs={crumbs}
  schema={[...(posts.length ? [itemListNode(path, posts.map((p) => ({ name: p.data.title, url: postPath(p) })))] : []), ...(hub.data.faq.length ? [faqNode(path, hub.data.faq)] : [])]}
>
  <PageHeader title={hub.data.title ?? topic.label} kicker="Blog topic" lead={topic.short} breadcrumbs={crumbs} />

  <div class="wrap pt-14 md:pt-20"><div class="prose"><Content /></div></div>

  {
    pillars.length > 0 && (
      <section class="wrap pt-16" aria-labelledby="start-here">
        <h2 id="start-here" class="display text-step-3">Start here</h2>
        <ul class="mt-8 grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">{pillars.map((p) => <li><PostCard post={p} /></li>)}</ul>
      </section>
    )
  }

  <section class="wrap pt-16" aria-labelledby="all-posts">
    <h2 id="all-posts" class="display text-step-3">{pillars.length ? 'All posts' : 'Posts'}</h2>
    {
      rest.length ? (
        <ul class="mt-8 grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">{rest.map((p) => <li><PostCard post={p} /></li>)}</ul>
      ) : (
        <p class="mt-6 border-t border-line py-8 text-muted">{pillars.length ? 'More soon.' : 'Posts on this topic are on the way.'}</p>
      )
    }
  </section>

  {hub.data.faq.length > 0 && <div class="wrap pt-20"><Faq items={hub.data.faq} /></div>}

  <nav class="wrap pt-20" aria-label="More from the blog">
    <p class="label">More from the blog</p>
    <ul class="mt-4 flex flex-wrap gap-2">
      <li><a class="inline-block rounded-full border border-line px-4 py-2 hover:border-ink" href="/blog/">All posts</a></li>
      {others.map((t) => <li><a class="inline-block rounded-full border border-line px-4 py-2 hover:border-ink" href={t.href}>{t.label}</a></li>)}
    </ul>
  </nav>

  <CtaPanel />
</Layout>
