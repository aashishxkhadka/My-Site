---
/**
 * /services/digital-marketing/pokhara/ — local service page for Pokhara ("editorial" layout).
 * Words live in src/data/pokhara.ts; this file is layout only.
 * Hand-built (not from the services collection) because its sections are unique.
 * No FAQPage or self-serving review schema, on purpose.
 */
import { getEntry, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '@/designs/d4/Layout.astro';
import Breadcrumbs from '@/components/seo/Breadcrumbs.astro';
import Button from '@/designs/d4/components/Button.astro';
import DataTable from '@/designs/d4/components/DataTable.astro';
import Icon from '@/designs/d4/components/Icon.astro';
import Faq from '@/designs/d4/components/Faq.astro';
import Testimonials from '@/designs/d4/components/Testimonials.astro';
import CtaPanel from '@/designs/d4/components/CtaPanel.astro';
import AuthorBox from '@/designs/d4/components/AuthorBox.astro';
import { withHome } from '@/lib/crumbs';
import { localBusinessNode } from '@/lib/schema';
import { STATS, SOCIALS } from '@/site.config';
import { path, crumbs, title, description, ogDescription, ogImage, ogImageAlt, whatsapp, glance, testimonialIds, prices, toc, n, markets, months, seasons, meaning, services, who, steps, costFactors, reasons, tips, faq } from '@/data/pokhara';
import lake from '@/assets/pokhara/phewa-lake.png';

const google = SOCIALS.find((s) => s.key === 'gbp')?.url;

/** Real results only. Flip to true once the table below has real numbers (never placeholders). */
const showResults = false;

const testimonials = (await Promise.all(testimonialIds.map((id) => getEntry('testimonials', id)))).filter(
  (t): t is CollectionEntry<'testimonials'> => !!t && (import.meta.env.DEV || !t.data.draft),
);

// Season calendar bars: taller = busier.
const barHeight = { peak: 'h-20 md:h-24', festival: 'h-24 md:h-28', monsoon: 'h-8 md:h-10', winter: 'h-12 md:h-14' } as const;

const chapter = 'border-t border-line pt-14 md:pt-20';
const num = 'display block text-[clamp(3rem,6vw,5rem)] leading-none text-transparent [-webkit-text-stroke:1.5px_var(--accent)]';
const h2 = 'display mt-4 text-step-4';
const body = 'mt-6 max-w-2xl text-step-1 leading-relaxed text-muted';
---

<Layout
  rawTitle={title}
  description={description}
  ogDescription={ogDescription}
  ogImage={ogImage}
  ogImageSize={{ width: 1200, height: 630 }}
  ogImageAlt={ogImageAlt}
  breadcrumbs={crumbs}
  schema={[
    localBusinessNode({
      path,
      name: 'Aashish Khadka: Digital Marketing in Pokhara',
      description,
      city: 'Pokhara',
      streetAddress: 'Buddha Chowk',
      priceRange: 'NPR 5,000+',
      offers: prices,
    }),
  ]}
>
  <!-- Hero: full-width Phewa Lake photo, darkened, text on top -->
  <section class="stage relative isolate overflow-hidden" aria-labelledby="page-title">
    <Image
      src={lake}
      alt="Phewa Lake and Machhapuchhre in Pokhara, with a boat on the water"
      widths={[740]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 -z-10 h-full w-full object-cover object-[50%_62%]"
    />
    <!-- Phones: even dark tint (text spans the full width). Desktop: dark on the text side, photo shows through on the right. -->
    <div class="absolute inset-0 -z-10 bg-[rgba(20,20,19,0.82)] md:bg-[linear-gradient(90deg,rgba(20,20,19,0.94)_0%,rgba(20,20,19,0.82)_45%,rgba(20,20,19,0.35)_100%)]" aria-hidden="true"></div>
    <div class="absolute inset-x-0 bottom-0 -z-10 h-32 bg-gradient-to-t from-[rgba(20,20,19,0.85)] to-transparent" aria-hidden="true"></div>

    <div class="wrap pb-20 pt-8 md:pb-32 md:pt-12">
      <Breadcrumbs crumbs={withHome(crumbs)!} />
      <p class="label mt-12 flex items-center gap-3 text-ink md:mt-16"><span class="h-px w-8 bg-accent" aria-hidden="true"></span>Digital Marketing in Pokhara</p>
      <h1 id="page-title" class="display mt-5 max-w-4xl text-[clamp(2.5rem,6.2vw,5.5rem)] leading-[0.95]">Digital marketing in <span class="text-accent">Pokhara</span> that brings real enquiries, not just likes</h1>
      <div class="mt-8 max-w-2xl space-y-4 text-step-1 leading-snug text-[#dcd9d2]">
        <p>I'm Aashish, a digital marketer based in Pokhara. With my team, I've worked with <strong class="text-ink">more than {STATS.businessesWorkedWith} businesses</strong>, and most of them still work with us today.</p>
        <p>I help Pokhara businesses get found on Google, show up on Google Maps, and turn social media and ads into real calls, WhatsApp messages and bookings. Not just likes.</p>
      </div>
      <div class="mt-10 flex flex-wrap items-center gap-3">
        <Button href={whatsapp} target="_blank" rel="nofollow noopener">Chat on WhatsApp</Button>
        <Button href="/contact/" variant="outline" class="bg-[#141413]/40 backdrop-blur">Book a free 30-minute call</Button>
        {
          google && (
            <a href={google} target="_blank" rel="noopener" class="ml-1 flex items-center gap-2 text-step--1 font-semibold">
              <span class="flex text-accent">{Array.from({ length: 5 }, () => <Icon name="star" class="size-4 fill-current" />)}</span>
              {STATS.googleRating.toFixed(1)} on Google
            </a>
          )
        }
      </div>
    </div>
  </section>

  <!-- Stat band -->
  <div class="border-b border-line bg-paper">
    <dl class="wrap grid grid-cols-2 gap-y-6 py-8 md:grid-cols-4 md:divide-x md:divide-line md:py-10">
      {
        [
          [`${STATS.googleRating.toFixed(1)}★`, 'Google rating'],
          [`${STATS.businessesWorkedWith}+`, 'businesses served'],
          ['299,831', 'Annapurna visitors, 2025'],
          ['NPR 5,000', 'starting price'],
        ].map(([v, l]) => (
          <div class="flex flex-col-reverse md:px-8 md:first:pl-0">
            <dt class="mt-1 text-step--1 text-muted">{l}</dt>
            <dd class="display text-step-3 text-accent">{v}</dd>
          </div>
        ))
      }
    </dl>
  </div>

  <!-- Phones and tablets: jump bar (desktop gets the sticky contents list) -->
  <nav class="border-b border-line lg:hidden" aria-label="Jump to a section">
    <div class="wrap flex items-center gap-3 overflow-x-auto py-3 [scrollbar-width:none]">
      <span class="label shrink-0">Jump to</span>
      <ul class="flex shrink-0 gap-2">
        {toc.map((t) => <li><a class="inline-block whitespace-nowrap rounded-full border border-line px-4 py-2 text-step--1 font-semibold hover:border-accent hover:text-accent" href={`#${t.id}`}>{t.label}</a></li>)}
      </ul>
    </div>
  </nav>

  <div class="wrap grid gap-12 pt-14 md:pt-20 lg:grid-cols-12">
    <!-- Desktop: sticky contents -->
    <aside class="hidden lg:col-span-3 lg:block">
      <div class="sticky top-28 space-y-6">
        <nav aria-label="On this page">
          <p class="label">Contents</p>
          <ol class="mt-4 space-y-1 border-l border-line">
            {toc.map((t, i) => <li><a class="-ml-px flex gap-3 border-l-2 border-transparent py-1.5 pl-4 text-step--1 font-medium text-muted hover:border-accent hover:text-ink" href={`#${t.id}`}><span class="tabular-nums text-accent">{String(i + 1).padStart(2, '0')}</span>{t.label}</a></li>)}
          </ol>
        </nav>
        <div class="stage rounded-2xl p-5">
          <p class="title text-step-1">Quick question?</p>
          <p class="mt-1 text-step--1 text-muted">Message me on WhatsApp.</p>
          <a href={whatsapp} target="_blank" rel="nofollow noopener" class="mt-4 inline-flex rounded-full bg-accent px-4 py-2 text-step--1 font-semibold text-on-accent">Chat on WhatsApp →</a>
        </div>
      </div>
    </aside>

    <div class="min-w-0 space-y-24 lg:col-span-9">
      <!-- In short -->
      <aside class="rounded-3xl bg-surface p-6 md:p-8" aria-labelledby="glance">
        <h2 id="glance" class="label">In short</h2>
        <ul class="mt-5 grid gap-x-8 gap-y-4 sm:grid-cols-2">
          {glance.map(([b, t]) => <li class="flex gap-3"><Icon name="check" class="mt-1 size-4 shrink-0 text-accent" /><p class="leading-snug"><strong class="font-semibold">{b}</strong> <span class="text-muted">{t}</span></p></li>)}
        </ul>
      </aside>

      <!-- 01 Why Pokhara -->
      <section class={chapter} aria-labelledby="different">
        <span class={num} aria-hidden="true">{n('different')}</span>
        <h2 id="different" class={h2}>Why digital marketing in Pokhara is different</h2>
        <p class={body}>Most digital marketing advice online is written for big cities or for other countries. Pokhara doesn't work like that. If you copy a Kathmandu or international playbook here, you'll waste money. Here's what makes this city different.</p>

        <h3 class="title mt-14 text-step-2">Pokhara is two markets in one city</h3>
        <p class="mt-3 text-muted">Every business here is selling to one, or both, of these groups:</p>
        <div class="mt-8 overflow-hidden rounded-3xl border border-line">
          <div class="grid grid-cols-2 bg-surface md:grid-cols-[11rem_1fr_1fr]">
            <span class="hidden md:block"></span>
            <p class="title flex items-center gap-2 p-4 text-step-1"><Icon name="globe" class="size-5 shrink-0 text-accent" />Tourists and travellers</p>
            <p class="title flex items-center gap-2 border-l border-line p-4 text-step-1"><Icon name="pin" class="size-5 shrink-0 text-accent" />Local customers</p>
          </div>
          {
            markets.rows.map((r, i) => (
              <div class="grid grid-cols-2 border-t border-line md:grid-cols-[11rem_1fr_1fr]">
                <p class="label col-span-2 px-4 pt-4 text-ink md:col-span-1 md:py-4">{r}</p>
                <p class="p-4 leading-snug">{markets.tourists[i]}</p>
                <p class="border-l border-line p-4 leading-snug">{markets.locals[i]}</p>
              </div>
            ))
          }
        </div>
        <blockquote class="mt-10 max-w-2xl">
          <p class="display text-step-2 leading-snug">"A hotel in Lakeside and a clinic in Prithvi Chowk need completely different strategies, even though they're in the same city."</p>
          <p class="mt-3 text-muted">That's the first thing I work out with every client.</p>
        </blockquote>

        <h3 class="title mt-16 text-step-2">The seasons decide your marketing calendar</h3>
        <p class={body}>Pokhara runs on seasons. Autumn (around September to November) and spring (around March to May) bring the biggest trekking and travel crowds. Festivals like Dashain and Tihar bring a big wave of domestic visitors. The monsoon is quieter.</p>
        <figure class="mt-8 rounded-3xl border border-line bg-paper p-5 md:p-8">
          <ol
            class="grid grid-cols-6 items-end gap-x-1.5 gap-y-4 md:grid-cols-12"
            role="img"
            aria-label="Pokhara's marketing seasons: March, April, May and September are peak travel season. October and November are peak season plus Dashain and Tihar. June, July and August are the quieter monsoon. December, January and February are a slower winter. The best months to launch campaigns are January and February for spring, and July and August for autumn."
          >
            {
              months.map(([m, s, launch]) => (
                <li class="flex flex-col items-center gap-1">
                  <span class:list={['w-full rounded-lg', seasons[s].class, barHeight[s]]} />
                  <span class="text-step--1 font-semibold">{m}</span>
                  <span class:list={['text-[0.6875rem] font-bold text-accent', !launch && 'invisible']}>▲</span>
                </li>
              ))
            }
          </ol>
          <figcaption class="mt-4 flex flex-wrap gap-x-5 gap-y-2 border-t border-line pt-4 text-step--1 text-muted" aria-hidden="true">
            {Object.values(seasons).map((s) => <span class="flex items-center gap-2"><span class:list={['size-3 rounded-sm', s.class]} />{s.label}</span>)}
            <span class="font-semibold text-accent">▲ Best time to launch campaigns</span>
          </figcaption>
        </figure>
        <p class={body}>The numbers show how big this market is. The Annapurna region recorded a record <strong class="text-ink">299,831 visitors in 2025</strong>, according to the Annapurna Conservation Area Project, and Pokhara is the main gateway to that region.</p>
        <p class="mt-6 max-w-2xl border-l-4 border-accent pl-5 text-step-1 font-semibold leading-snug">Good marketing here starts before the season, not during it. By the time the season begins, travellers have already planned and booked.</p>

        <h3 class="title mt-16 text-step-2">Your customers are online, mostly on their phones</h3>
        <figure class="mt-8">
          <dl class="grid divide-y divide-line border-y border-line sm:grid-cols-3 sm:divide-x sm:divide-y-0">
            {
              [['16.6M', 'internet users in Nepal, 56% of the population'], ['14.8M', 'social media user identities'], ['4.35M', 'people reachable with Instagram ads']].map(([v, l]) => (
                <div class="flex flex-col-reverse py-6 sm:px-6 sm:first:pl-0"><dt class="mt-2 leading-snug text-muted">{l}</dt><dd class="display text-step-4 leading-none">{v}</dd></div>
              ))
            }
          </dl>
          <figcaption class="mt-3 text-step--1 text-muted">Late 2025 figures from <a class="link" href="https://datareportal.com/reports/digital-2026-nepal" target="_blank" rel="noopener">DataReportal, Digital 2026: Nepal</a>. Facebook's ad audience was around 14.8 million.</figcaption>
        </figure>
        <p class="mt-10 font-semibold">What this means for a Pokhara business:</p>
        <ul class="mt-4 max-w-2xl space-y-4">
          {meaning.map((m) => <li class="flex gap-4"><Icon name={m.icon} class="mt-0.5 size-5 shrink-0 text-accent" /><p class="leading-relaxed"><strong class="font-semibold">{m.lead}</strong> <span class="text-muted">{m.text}</span></p></li>)}
        </ul>
      </section>

      <!-- 02 Services -->
      <section class={chapter} aria-labelledby="services">
        <span class={num} aria-hidden="true">{n('services')}</span>
        <h2 id="services" class={h2}>Digital marketing services I offer in Pokhara</h2>
        <p class={body}>I don't sell fixed packages. Every plan is built from these services, based on what your business actually needs.</p>
        <ol class="mt-10 border-b border-line">
          {
            services.map((s) => (
              <li class="grid gap-4 border-t border-line py-8 md:grid-cols-[3.5rem_1fr]">
                <span class="grid size-12 place-items-center rounded-full border border-line text-accent"><Icon name={s.icon} class="size-5" /></span>
                <div>
                  <h3 class="title text-step-2">{s.title}</h3>
                  <p class="mt-3 max-w-2xl leading-relaxed text-muted">{s.text}</p>
                  {(s.bestFor || s.results) && (
                    <p class="mt-4 flex flex-wrap gap-x-6 gap-y-1 text-step--1">
                      {s.bestFor && <span><span class="font-semibold">Best for:</span> <span class="text-muted">{s.bestFor}</span></span>}
                      {s.results && <span><span class="font-semibold text-accent">Results:</span> <span class="text-muted">{s.results}</span></span>}
                    </p>
                  )}
                  {s.link && <a class="link mt-4 inline-block font-semibold" href={s.link.href}>{s.link.label} →</a>}
                </div>
              </li>
            ))
          }
        </ol>
      </section>

      <!-- 03 Who I help -->
      <section class={chapter} aria-labelledby="who">
        <span class={num} aria-hidden="true">{n('who')}</span>
        <h2 id="who" class={h2}>Who I work with in Pokhara</h2>
        <p class={body}>I work with businesses that want real growth, not vanity numbers. Most of my clients fall into these groups:</p>
        <dl class="mt-10 grid gap-x-10 sm:grid-cols-2">
          {who.map((w) => <div class="border-t border-line py-5"><dt class="title text-step-1">{w.type}</dt><dd class="mt-1 text-muted">{w.first.join(' · ')}</dd></div>)}
          <div class="border-t border-line py-5"><dt class="title text-step-1 text-accent">Outside Pokhara?</dt><dd class="mt-1 text-muted">I'm based in Pokhara, and I can work with businesses outside Pokhara remotely too.</dd></div>
        </dl>
      </section>

      {
        showResults && (
          <section class={chapter} aria-labelledby="results">
            <h2 id="results" class={h2}>Real results for Pokhara businesses</h2>
            <p class={body}>Anyone can promise results. Here's what we've actually achieved. To respect client privacy, I share the industry and the numbers, not the names.</p>
            <div class="mt-8">
              <DataTable
                label="Results for Pokhara businesses"
                head={['Industry', 'The challenge', 'What we did', 'Result']}
                rowHeaders
                rows={[
                  // TODO(Aashish): real numbers + timeframes, then set showResults = true.
                ]}
              />
            </div>
          </section>
        )
      }

      <!-- 04 How I work -->
      <section class={chapter} aria-labelledby="how">
        <span class={num} aria-hidden="true">{n('how')}</span>
        <h2 id="how" class={h2}>How I work</h2>
        <p class={body}>Most of my clients stay long-term, and I think this process is why. I don't sell random packages a business doesn't need.</p>
        <ol class="mt-10 space-y-8 border-l-2 border-line pl-8">
          {
            steps.map((s, i) => (
              <li class="relative">
                <span class:list={['title absolute -left-[3.05rem] grid size-10 place-items-center rounded-full text-step-0', i === steps.length - 1 ? 'bg-ink text-bg' : 'bg-accent text-on-accent']}>{i + 1}</span>
                <p class="title text-step-1">{s.title}</p>
                <p class="mt-1 max-w-xl leading-relaxed text-muted">{s.text}</p>
              </li>
            ))
          }
        </ol>
        <p class="mt-10 text-muted">Want to know where this way of working came from? <a class="link font-semibold text-ink" href="/stories/learning-outside-the-classroom/">Read my story</a>.</p>
      </section>

      <!-- 05 Pricing -->
      <section class={chapter} aria-labelledby="cost">
        <span class={num} aria-hidden="true">{n('cost')}</span>
        <h2 id="cost" class={h2}>How much does digital marketing cost in Pokhara?</h2>
        <p class={body}>The honest answer: it depends on what your business needs. A cafe that needs Google Maps and Instagram needs a very different budget from a trekking company targeting travellers in Europe.</p>
        <div class="mt-10 rounded-3xl bg-paper p-6 shadow-sm ring-1 ring-line md:p-10">
          <h3 class="label">Starting prices</h3>
          <ul class="mt-4">
            {
              prices.map((p) => (
                <li class="flex items-baseline gap-3 border-b border-dashed border-line py-4 last:border-0">
                  <span class="title text-step-1">{p.name}</span>
                  <span class="mx-1 hidden flex-1 border-b-2 border-dotted border-line sm:block" aria-hidden="true" />
                  <span class="ml-auto shrink-0 text-right"><span class="display text-step-2">NPR {p.amount}</span><span class="block text-step--1 text-muted">{p.per}</span></span>
                </li>
              ))
            }
          </ul>
        </div>
        <h3 class="title mt-12 text-step-2">What affects the cost</h3>
        <dl class="mt-4 max-w-3xl">
          {costFactors.map(([f, why]) => <div class="grid gap-1 border-t border-line py-4 sm:grid-cols-[14rem_1fr] sm:gap-6"><dt class="font-semibold">{f}</dt><dd class="text-muted">{why}</dd></div>)}
        </dl>
        <p class="mt-8 max-w-3xl rounded-2xl border-l-4 border-accent bg-surface p-6 leading-relaxed">These are base prices. Depending on your industry and the scope of work, the price may be different. After our first meeting, you get an exact quote based on your goals. No hidden costs, and no services you don't need. Ad budgets (money paid directly to Meta or Google) are separate from these fees.</p>
      </section>

      <!-- 06 Why local -->
      <section class={chapter} aria-labelledby="why">
        <span class={num} aria-hidden="true">{n('why')}</span>
        <h2 id="why" class={h2}>Why work with a Pokhara-based digital marketer</h2>
        <ul class="mt-10 grid gap-x-10 gap-y-8 sm:grid-cols-2">
          {reasons.map((r) => <li class="flex gap-4"><span class="grid size-11 shrink-0 place-items-center rounded-full bg-surface text-accent"><Icon name={r.icon} class="size-5" /></span><p class="leading-relaxed"><strong class="block font-semibold">{r.lead}</strong><span class="text-muted">{r.text}</span></p></li>)}
        </ul>
      </section>

      <!-- 07 Free tips: tick-off checklist (no JS) -->
      <section class={chapter} aria-labelledby="this-week">
        <span class={num} aria-hidden="true">{n('this-week')}</span>
        <h2 id="this-week" class={h2}>5 things any Pokhara business can do this week</h2>
        <p class={body}>Not ready to hire anyone yet? Start with these. They're free.</p>
        <ol class="mt-10">
          {
            tips.map(([b, t]) => (
              <li>
                <label class="tip flex cursor-pointer gap-4 border-b border-line py-5">
                  <input type="checkbox" class="mt-1 size-5 shrink-0 accent-[var(--accent)]" />
                  <span class="leading-relaxed"><strong class="font-semibold">{b}</strong> <span class="text-muted">{t}</span></span>
                </label>
              </li>
            ))
          }
        </ol>
        <p class="mt-8 text-muted">Want to go deeper? Check your website page by page with my <a class="link text-ink" href="/resource/on-page-seo-checklist-template/">free on-page SEO checklist template</a>, or read the <a class="link text-ink" href="/blog/on-page-seo-checklist/">on-page SEO checklist guide</a>.</p>
      </section>
    </div>
  </div>

  {testimonials.length > 0 && <Testimonials items={testimonials} title="What clients say." />}

  <div class="wrap pt-24 md:pt-32"><Faq items={faq} title="Frequently asked questions" /></div>

  <CtaPanel
    kicker="Work with me"
    title="Let's grow your business in Pokhara."
    lead="Tell me about your business and what you want to achieve. The first call is free, and you'll leave with at least one idea you can use straight away, whether we work together or not."
    whatsapp={whatsapp}
  />

  <div class="wrap -mt-12 pb-24 md:-mt-16 md:pb-32"><AuthorBox /></div>
</Layout>

<style>
  .tip:has(input:checked) strong { text-decoration: line-through; text-decoration-color: var(--accent); }
  h2[id] { scroll-margin-top: 7rem; }
</style>
