---
import Layout from '@/designs/d4/Layout.astro';
import BlogIndex from '@/designs/d4/components/BlogIndex.astro';
import CtaPanel from '@/designs/d4/components/CtaPanel.astro';
import { getPublished, byNewest } from '@/lib/content';
import { SECTIONS } from '@/site.config';

const size = SECTIONS.blog.pageSize;
const all = (await getPublished('blog')).sort(byNewest);
const last = Math.max(1, Math.ceil(all.length / size));
---

<Layout
  title="Blog"
  description="Writing by Aashish Khadka on SEO, AI search, local SEO, digital marketing and building products, for businesses in Nepal and abroad."
  pageType="CollectionPage"
  breadcrumbs={[{ label: 'Blog', href: '/blog/' }]}
>
  <BlogIndex posts={all.slice(0, size)} current={1} last={last} />
  <CtaPanel />
</Layout>
