---
import Layout from '@/designs/d4/Layout.astro';
import BlogIndex from '@/designs/d4/components/BlogIndex.astro';
import CtaPanel from '@/designs/d4/components/CtaPanel.astro';
import { getPublished, byNewest, latestDate } from '@/lib/content';
import { SECTIONS } from '@/site.config';

const size = SECTIONS.blog.pageSize;
const all = (await getPublished('blog')).sort(byNewest);
const last = Math.max(1, Math.ceil(all.length / size));
---

<Layout
  rawTitle="Blog: SEO, Marketing & Strategy | Aashish Khadka"
  description="Writing by Aashish Khadka on growth strategy, branding, digital marketing and SEO, for businesses in Nepal and abroad."
  noindex={all.length === 0}
  lastModified={latestDate(all)}
  pageType="CollectionPage"
  breadcrumbs={[{ label: 'Blog', href: '/blog/' }]}
>
  <BlogIndex section="blog" posts={all.slice(0, size)} current={1} last={last} />
  <CtaPanel />
</Layout>
