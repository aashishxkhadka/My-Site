---
/**
 * /blog/[slug]/ serves three kinds of page:
 *   - posts without a topic:  /blog/my-post/
 *   - topic hubs:             /blog/seo/ (built once the topic has a post)
 *   - redirects:              /blog/what-is-technical-seo/ → /blog/seo/what-is-technical-seo/
 * Posts with a topic live in ./[topic]/[slug].astro.
 * Topic keys and "page" are reserved, so a post slug can never shadow them.
 */
import type { GetStaticPaths } from 'astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import PostView from '@/views/PostView.astro';
import TopicView from '@/views/TopicView.astro';
import RedirectPage from '@/components/seo/RedirectPage.astro';
import { getPublished } from '@/lib/content';
import { postPath, postTopic } from '@/lib/posts';
import { topicsInfo, type TopicInfo } from '@/lib/taxonomy';
import { TOPICS, TOPIC_KEYS } from '@/site.config';

export const getStaticPaths = (async () => {
  const posts = await getPublished('blog');
  const reserved = [...TOPIC_KEYS, 'page'] as string[];
  const clash = posts.find((p) => reserved.includes(p.id));
  if (clash) throw new Error(`Blog post slug "${clash.id}" is reserved (topic hub or pagination). Rename the post.`);

  const hubs = await getCollection('topics');
  const missing = TOPICS.find((t) => !hubs.some((h) => h.id === t.key));
  if (missing) throw new Error(`Topic "${missing.key}" has no intro file at src/content/topics/${missing.key}.mdx`);

  const topics = (await topicsInfo()).filter((t) => t.hasPage);
  return [
    ...posts.map((post) =>
      postTopic(post)
        ? { params: { slug: post.id }, props: { kind: 'redirect' as const, to: postPath(post) } }
        : { params: { slug: post.id }, props: { kind: 'post' as const, post } },
    ),
    ...topics.map((topic) => ({ params: { slug: topic.key }, props: { kind: 'topic' as const, topic, hub: hubs.find((h) => h.id === topic.key)! } })),
  ];
}) satisfies GetStaticPaths;

type Props =
  | { kind: 'post'; post: CollectionEntry<'blog'> }
  | { kind: 'topic'; topic: TopicInfo; hub: CollectionEntry<'topics'> }
  | { kind: 'redirect'; to: string };
const props = Astro.props as Props;
---

{props.kind === 'post' && <PostView post={props.post} />}
{props.kind === 'topic' && <TopicView topic={props.topic} hub={props.hub} />}
{props.kind === 'redirect' && <RedirectPage to={props.to} />}
