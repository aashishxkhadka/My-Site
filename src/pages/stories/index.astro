---
import Layout from '@/designs/d4/Layout.astro';
import BlogIndex from '@/designs/d4/components/BlogIndex.astro';
import CtaPanel from '@/designs/d4/components/CtaPanel.astro';
import { getPublished, byNewest, latestDate } from '@/lib/content';
import { SECTIONS } from '@/site.config';

const size = SECTIONS.stories.pageSize;
const all = (await getPublished('stories')).sort(byNewest);
const last = Math.max(1, Math.ceil(all.length / size));
---

<Layout
  rawTitle="Stories: Building a Business in Nepal | Aashish Khadka"
  description="Stories from Aashish Khadka: starting Basilpot, building products, working with businesses in Nepal and abroad, and lessons learned."
  noindex={all.length === 0}
  lastModified={latestDate(all)}
  pageType="CollectionPage"
  breadcrumbs={[{ label: 'Stories', href: '/stories/' }]}
>
  <BlogIndex section="stories" posts={all.slice(0, size)} current={1} last={last} />
  <CtaPanel />
</Layout>
