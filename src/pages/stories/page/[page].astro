---
import type { GetStaticPaths } from 'astro';
import Layout from '@/designs/d4/Layout.astro';
import BlogIndex from '@/designs/d4/components/BlogIndex.astro';
import CtaPanel from '@/designs/d4/components/CtaPanel.astro';
import { getPublished, byNewest } from '@/lib/content';
import { SECTIONS } from '@/site.config';

/** Page 1 is /stories/ itself; this builds /stories/page/2/ onwards. */
export const getStaticPaths = (async () => {
  const size = SECTIONS.stories.pageSize;
  const all = (await getPublished('stories')).sort(byNewest);
  const last = Math.max(1, Math.ceil(all.length / size));
  return Array.from({ length: Math.max(0, last - 1) }, (_, i) => i + 2).map((n) => ({
    params: { page: String(n) },
    props: { posts: all.slice((n - 1) * size, n * size), current: n, last },
  }));
}) satisfies GetStaticPaths;

const { posts, current, last } = Astro.props;
---

<Layout
  title={`Stories, page ${current}`}
  description={`Page ${current} of stories by Aashish Khadka on building Basilpot, products and client work.`}
  pageType="CollectionPage"
  breadcrumbs={[{ label: 'Stories', href: '/stories/' }, { label: `Page ${current}`, href: `/stories/page/${current}/` }]}
>
  <BlogIndex section="stories" posts={posts} current={current} last={last} />
  <CtaPanel />
</Layout>
