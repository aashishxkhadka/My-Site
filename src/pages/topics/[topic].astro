---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import Layout from '@/designs/d4/Layout.astro';
import PageHeader from '@/designs/d4/components/PageHeader.astro';
import PostRow from '@/designs/d4/components/PostRow.astro';
import Faq from '@/designs/d4/components/Faq.astro';
import CtaPanel from '@/designs/d4/components/CtaPanel.astro';
import { getPublished, byNewest } from '@/lib/content';
import { itemListNode, faqNode } from '@/lib/schema';
import { TOPICS } from '@/site.config';

/** Registry in site.config; written intro in src/content/topics/<key>.mdx (required). */
export const getStaticPaths = (async () => {
  const hubs = await getCollection('topics');
  return TOPICS.map((topic) => {
    const hub = hubs.find((h) => h.id === topic.key);
    if (!hub) throw new Error(`Topic "${topic.key}" has no intro file at src/content/topics/${topic.key}.mdx`);
    return { params: { topic: topic.key }, props: { topic, hub } };
  });
}) satisfies GetStaticPaths;

const { topic, hub } = Astro.props;
const { Content } = await render(hub);
const path = `/topics/${topic.key}/`;
const posts = (await getPublished('blog')).filter((p) => (p.data.topics as string[]).includes(topic.key)).sort(byNewest);
const pillarIds = hub.data.pillars.map((p) => p.id);
const pillars = posts.filter((p) => pillarIds.includes(p.id));
const rest = posts.filter((p) => !pillarIds.includes(p.id));
const others = TOPICS.filter((t) => t.key !== topic.key);
const crumbs = [{ label: 'Blog', href: '/blog/' }, { label: topic.label, href: path }];
// A hub with no posts yet is thin: keep it out of the index until it has content.
const thin = posts.length === 0;
---

<Layout
  title={hub.data.title ?? topic.label}
  rawTitle={hub.data.seo.title}
  description={hub.data.description}
  noindex={hub.data.seo.noindex || thin}
  pageType="CollectionPage"
  breadcrumbs={crumbs}
  schema={[...(posts.length ? [itemListNode(path, posts.map((p) => ({ name: p.data.title, url: `/blog/${p.id}/` })))] : []), ...(hub.data.faq.length ? [faqNode(path, hub.data.faq)] : [])]}
>
  <PageHeader title={hub.data.title ?? topic.label} kicker="Topic" lead={topic.short} breadcrumbs={crumbs} />

  <div class="wrap pt-14 md:pt-20"><div class="prose"><Content /></div></div>

  {
    pillars.length > 0 && (
      <section class="wrap pt-16" aria-labelledby="start-here">
        <h2 id="start-here" class="display text-step-3">Start here</h2>
        <div class="mt-6 border-b border-line">{pillars.map((p) => <PostRow post={p} />)}</div>
      </section>
    )
  }

  <section class="wrap pt-16" aria-labelledby="all-posts">
    <h2 id="all-posts" class="display text-step-3">{pillars.length ? 'All posts' : 'Posts'}</h2>
    <div class="mt-6 border-b border-line">
      {rest.length ? rest.map((p) => <PostRow post={p} />) : <p class="border-t border-line py-8 text-muted">{pillars.length ? 'More soon.' : 'Posts on this topic are on the way.'}</p>}
    </div>
  </section>

  {hub.data.faq.length > 0 && <div class="wrap pt-20"><Faq items={hub.data.faq} /></div>}

  <nav class="wrap pt-20" aria-label="Other topics">
    <p class="label">Other topics</p>
    <ul class="mt-4 flex flex-wrap gap-2">
      {others.map((t) => <li><a class="inline-block rounded-full border border-line px-4 py-2 hover:border-ink" href={`/topics/${t.key}/`}>{t.label}</a></li>)}
    </ul>
  </nav>

  <CtaPanel />
</Layout>
