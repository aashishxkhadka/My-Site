---
import Layout from '@/designs/d4/Layout.astro';
import PageHeader from '@/designs/d4/components/PageHeader.astro';
import ProductCard from '@/designs/d4/components/ProductCard.astro';
import CtaPanel from '@/designs/d4/components/CtaPanel.astro';
import Button from '@/designs/d4/components/Button.astro';
import { getPublished, byOrder } from '@/lib/content';
import { itemListNode, productNode } from '@/lib/schema';
import { BASILPOT } from '@/site.config';

const projects = (await getPublished('projects')).sort(byOrder);
const crumbs = [{ label: 'Projects', href: '/projects/' }];
---

<Layout
  rawTitle="Products Built at Basilpot | Aashish Khadka"
  description="Products built and run at Basilpot: LINKS, Reviewpot, TravelFast, HQ Nepal, Launch Bunch, Fullbleed and Ash & Moss."
  pageType="CollectionPage"
  breadcrumbs={crumbs}
  schema={[
    itemListNode('/projects/', projects.map((p) => ({ name: p.data.title, url: p.data.url ?? '/projects/' }))),
    ...projects.map((p) => productNode({ name: p.data.title, description: p.data.description, url: p.data.url, type: p.data.schemaType, applicationCategory: p.data.applicationCategory, image: p.data.screenshot?.src })),
  ]}
>
  <PageHeader title="Built at Basilpot." kicker="Projects" lead="Alongside client work, we build and run products of our own. Each one started as a problem worth solving." breadcrumbs={crumbs}>
    <div class="mt-9"><Button href={BASILPOT.url} variant="outline">Visit Basilpot</Button></div>
  </PageHeader>

  <h2 class="sr-only">Products</h2>
  <ul class="wrap grid gap-x-8 gap-y-16 pt-16 sm:grid-cols-2 md:pt-20 lg:grid-cols-3">
    {projects.map((p) => <li class="[&>article]:h-auto"><ProductCard project={p} /><p class="mt-3 text-step--1 leading-relaxed text-muted">{p.data.description}</p></li>)}
  </ul>

  <p class="wrap pt-16 text-step-1 text-muted">Need something built for your business? We build client sites the same way: see <a class="link text-ink" href="/services/website-development/">website design &amp; development</a> or <a class="link text-ink" href="/work/">recent client work</a>.</p>

  <CtaPanel title="Have a product idea?" lead="Basilpot takes ideas from plan to launch to growth. Tell me what you want to build." />
</Layout>
