---
import type { GetStaticPaths } from 'astro';
import { render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '@/designs/d4/Layout.astro';
import PageHeader from '@/designs/d4/components/PageHeader.astro';
import CtaPanel from '@/designs/d4/components/CtaPanel.astro';
import WorkCard from '@/designs/d4/components/WorkCard.astro';
import Todo from '@/components/ui/Todo.astro';
import { getPublished, byOrder } from '@/lib/content';
import { caseStudyNode } from '@/lib/schema';
import { formatDate, isoDate } from '@/lib/format';

export const getStaticPaths = (async () => {
  const work = await getPublished('work');
  return work.map((item) => ({ params: { slug: item.id }, props: { item } }));
}) satisfies GetStaticPaths;

const { item } = Astro.props as { item: CollectionEntry<'work'> };
const d = item.data;
const { Content } = await render(item);
const path = `/work/${item.id}/`;
const services = await getPublished('services');
const svc = d.services.map((s) => services.find((x) => x.id === s.id)).filter((s): s is CollectionEntry<'services'> => !!s);
const more = (await getPublished('work')).filter((w) => w.id !== item.id).sort(byOrder).slice(0, 2);
const titleOf = (id: string) => services.find((s) => s.id === id)?.data.title ?? id;
const host = d.clientUrl ? new URL(d.clientUrl).host.replace(/^www\./, '') : undefined;
const hasBody = (item.body ?? '').replace(/\{\/\*[\s\S]*?\*\/\}/g, '').trim().length > 0;
const crumbs = [{ label: 'Work', href: '/work/' }, { label: d.client ?? d.title, href: path }];
---

<Layout
  title={d.title}
  rawTitle={d.seo.title}
  description={d.description}
  noindex={d.seo.noindex}
  ogType="article"
  publishedTime={d.pubDate}
  modifiedTime={d.updatedDate}
  breadcrumbs={crumbs}
  schema={[caseStudyNode({ path, title: d.title, description: d.description, pubDate: d.pubDate, updatedDate: d.updatedDate, image: d.heroImage?.src, client: d.client })]}
>
  <PageHeader title={d.title} kicker={`${d.client ?? 'Client'} · ${d.industry}`} lead={d.summary} breadcrumbs={crumbs} />

  <div class="wrap pt-14 md:pt-20">
    {
      d.heroImage && (
        <figure class="overflow-hidden rounded-2xl border border-line bg-paper shadow-[0_30px_80px_-40px_rgb(0_0_0/0.45)]">
          <div class="flex items-center gap-1.5 border-b border-line px-4 py-3" aria-hidden="true">
            <span class="size-2.5 rounded-full bg-line" /><span class="size-2.5 rounded-full bg-line" /><span class="size-2.5 rounded-full bg-line" />
            {host && <span class="ml-3 text-[0.75rem] text-muted">{host}</span>}
          </div>
          <Image src={d.heroImage} alt={d.heroAlt ?? ''} widths={[640, 1024, 1440]} sizes="(min-width: 1312px) 1216px, 92vw" loading="eager" class="h-auto w-full" />
        </figure>
      )
    }
  </div>

  <div class="wrap grid gap-12 pt-16 md:grid-cols-12 md:pt-20">
    <aside class="md:col-span-4" aria-label="Project details">
      <dl class="space-y-6 rounded-2xl border border-line bg-paper p-6 md:sticky md:top-28">
        {d.client && <div><dt class="label">Client</dt><dd class="mt-1 font-semibold">{d.client}</dd></div>}
        <div><dt class="label">Industry</dt><dd class="mt-1 font-semibold">{d.industry}</dd></div>
        <div>
          <dt class="label">Services</dt>
          <dd class="mt-2 flex flex-wrap gap-2">{svc.map((s) => <a class="rounded-full border border-line px-3 py-1 text-step--1 hover:border-ink" href={`/services/${s.id}/`}>{s.data.title}</a>)}</dd>
        </div>
        <div><dt class="label">Delivered</dt><dd class="mt-1 font-semibold">{d.via === 'basilpot' ? 'With the Basilpot team' : 'Personally'}</dd></div>
        <div><dt class="label">Published</dt><dd class="mt-1"><time datetime={isoDate(d.pubDate)}>{formatDate(d.pubDate)}</time></dd></div>
        {d.clientUrl && <a class="link block font-semibold text-accent" href={d.clientUrl} target="_blank" rel="noopener">Visit {host} ↗</a>}
      </dl>
    </aside>

    <article class="md:col-span-8">
      {
        d.results.length > 0 && (
          <dl class="mb-12 grid gap-6 border-y border-line py-8 sm:grid-cols-3">
            {d.results.map((r) => (
              <div class="flex flex-col-reverse">
                <dt class="mt-1 text-step--1 text-muted">{r.label}</dt>
                <dd class="display text-step-4 text-accent">{r.value}</dd>
              </div>
            ))}
          </dl>
        )
      }
      <div class="prose">
        {hasBody ? <Content /> : (
          <>
            <h2>The problem</h2>
            <p><Todo note="What was wrong, and why it mattered to the business">TODO: the situation before.</Todo></p>
            <h2>The approach</h2>
            <p><Todo note="What we did, and why">TODO: what we did.</Todo></p>
            <h2>The result</h2>
            <p><Todo note="Real outcomes only: enquiries, bookings, traffic, rankings">TODO: what changed. Real numbers only.</Todo></p>
          </>
        )}
      </div>
    </article>
  </div>

  {
    more.length > 0 && (
      <section class="wrap pt-24 md:pt-32" aria-labelledby="more-work">
        <h2 id="more-work" class="display text-step-4">More work</h2>
        <div class="mt-10 grid gap-14 md:grid-cols-2 md:gap-10">
          {more.map((w) => <WorkCard item={w} serviceTitles={w.data.services.map((s) => titleOf(s.id))} />)}
        </div>
      </section>
    )
  }

  <CtaPanel />
</Layout>
