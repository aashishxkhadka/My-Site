---
/** Visible breadcrumb trail. Its BreadcrumbList node is added by BaseLayout. */
import type { Crumb } from '@/lib/schema';

export interface Props {
  crumbs: Crumb[];
  /** Long current-page labels: hidden on phones, one truncated line from md up. */
  compact?: boolean | undefined;
}

const { crumbs, compact } = Astro.props;
---

<nav aria-label="Breadcrumb" class="label">
  <ol class:list={['flex flex-wrap items-center gap-x-2 gap-y-1', compact && 'md:flex-nowrap']}>
    {
      crumbs.map((c, i) => (
        <li class:list={['items-center gap-2', compact && i === crumbs.length - 1 ? 'hidden min-w-0 md:flex' : 'flex shrink-0']}>
          {i > 0 && <span aria-hidden="true" class="text-muted">/</span>}
          {i === crumbs.length - 1 ? (
            <span aria-current="page" class:list={['text-ink', compact && 'truncate']}>{c.label}</span>
          ) : (
            <a href={c.href} class="link -my-3 inline-block py-3">{c.label}</a>
          )}
        </li>
      ))
    }
  </ol>
</nav>
