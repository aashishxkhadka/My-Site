---
/** Dev-only floating switcher between design candidates. Never ships. */
import { DESIGNS } from '@/designs/registry';

const path = Astro.url.pathname;
const current = DESIGNS.find((d) => path.startsWith(`/designs/${d.id}/`))?.id;
---

<nav class="ds" aria-label="Design candidates (dev only)">
  <span class="ds-label">design</span>
  {
    DESIGNS.map((d) => (
      <a href={`/designs/${d.id}/`} aria-current={current === d.id ? 'page' : undefined} title={`${d.name}: ${d.note}`}>
        {d.id}
      </a>
    ))
  }
  <a href="/" aria-current={!current && path === '/' ? 'page' : undefined} title="Homepage (current pick)">/</a>
</nav>

<style>
  .ds {
    position: fixed; left: 12px; bottom: 12px; z-index: 2147483000;
    display: flex; align-items: center; gap: 2px; padding: 4px;
    font: 500 12px/1 ui-monospace, SFMono-Regular, Menlo, monospace;
    background: #111; color: #fff; border-radius: 999px;
    box-shadow: 0 8px 30px -8px rgb(0 0 0 / 0.5);
  }
  .ds-label { padding: 0 8px 0 10px; opacity: 0.55; }
  .ds a { color: inherit; text-decoration: none; padding: 7px 10px; border-radius: 999px; }
  .ds a:hover { background: #333; }
  .ds a[aria-current='page'] { background: #fff; color: #111; }
</style>
