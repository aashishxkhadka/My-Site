---
/** Shared body for /blog/ and /blog/page/N/. */
import type { CollectionEntry } from 'astro:content';
import PageHeader from './PageHeader.astro';
import PostRow from './PostRow.astro';
import Pagination from './Pagination.astro';
import { TOPICS } from '@/site.config';

export interface Props {
  posts: CollectionEntry<'blog'>[];
  current: number;
  last: number;
}
const { posts, current, last } = Astro.props;
const crumbs = [{ label: 'Blog', href: '/blog/' }, ...(current > 1 ? [{ label: `Page ${current}`, href: `/blog/page/${current}/` }] : [])];
---

<PageHeader title="Notes on growth." kicker="Blog" lead="Practical writing on SEO, marketing, branding and building products, from the work itself." breadcrumbs={crumbs} />

<div class="wrap pt-12 md:pt-16">
  <nav aria-label="Topics" class="flex flex-wrap items-center gap-2">
    <span class="label mr-2">Topics</span>
    {TOPICS.map((t) => <a class="rounded-full border border-line px-4 py-2 text-step--1 font-semibold hover:border-ink" href={`/topics/${t.key}/`}>{t.label}</a>)}
  </nav>

  <div class="mt-12 border-b border-line">
    {posts.length > 0 ? posts.map((p) => <PostRow post={p} />) : <p class="border-t border-line py-10 text-muted">First posts are on the way.</p>}
  </div>

  <Pagination current={current} last={last} base="/blog/" />
</div>
