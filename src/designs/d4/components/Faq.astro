---
/** Accessible FAQ: native <details>, no JS. */
export interface Props {
  items: { question: string; answer: string }[];
  title?: string;
}
const { items, title = 'Questions' } = Astro.props;
---

{
  items.length > 0 && (
    <section aria-labelledby="faq-title">
      <h2 id="faq-title" class="display text-step-3">{title}</h2>
      <div class="mt-8 border-t border-line">
        {items.map((f) => (
          <details class="faq group border-b border-line">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 text-step-1 font-semibold">
              {f.question}
              <span class="grid size-9 shrink-0 place-items-center rounded-full border border-line transition-transform duration-300 group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <p class="max-w-2xl pb-6 text-muted">{f.answer}</p>
          </details>
        ))}
      </div>
    </section>
  )
}

<style>
  .faq summary::-webkit-details-marker { display: none; }
</style>
