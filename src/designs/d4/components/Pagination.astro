---
/** Real <a> pagination (crawlable). Page 1 lives at `base`, others at `base` + page/N/. */
export interface Props {
  current: number;
  last: number;
  base: string;
}
const { current, last, base } = Astro.props;
const href = (n: number) => (n === 1 ? base : `${base}page/${n}/`);
const pages = Array.from({ length: last }, (_, i) => i + 1);
---

{
  last > 1 && (
    <nav aria-label="Pagination" class="mt-16 flex items-center justify-between gap-4 border-t border-line pt-8">
      {current > 1 ? <a class="link font-semibold" href={href(current - 1)} rel="prev">← Newer</a> : <span />}
      <ol class="flex gap-1">
        {pages.map((n) => (
          <li>
            <a
              href={href(n)}
              aria-current={n === current ? 'page' : undefined}
              class="grid size-10 place-items-center rounded-full font-semibold hover:bg-surface aria-[current=page]:bg-accent aria-[current=page]:text-on-accent"
            >
              {n}
            </a>
          </li>
        ))}
      </ol>
      {current < last ? <a class="link font-semibold" href={href(current + 1)} rel="next">Older →</a> : <span />}
    </nav>
  )
}
