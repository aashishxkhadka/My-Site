---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { workHref } from '@/lib/content';

export interface Props {
  item: CollectionEntry<'work'>;
  /** Service tags, linked to their service pages. */
  services?: { title: string; href: string }[];
  large?: boolean;
  /** Equal-height text (2-line title and summary) and no service tags, for rows of cards. */
  compact?: boolean;
}
const { item, services = [], large = false, compact = false } = Astro.props;
const { title, client, industry, summary, heroImage, heroAlt, clientUrl } = item.data;
const href = workHref(item);
const external = /^https?:/.test(href);
const host = clientUrl ? new URL(clientUrl).host.replace(/^www\./, '') : undefined;
---

<article class:list={['scroll-in group relative', large && 'md:grid md:grid-cols-12 md:items-center md:gap-12']}>
  <div class:list={['overflow-hidden rounded-2xl border border-line bg-paper shadow-[0_24px_60px_-30px_rgb(0_0_0/0.35)]', large && 'md:col-span-7']}>
    <div class="flex items-center gap-1.5 border-b border-line px-4 py-2.5" aria-hidden="true">
      <span class="size-2.5 rounded-full bg-line"></span><span class="size-2.5 rounded-full bg-line"></span><span class="size-2.5 rounded-full bg-line"></span>
      {host && <span class="ml-3 truncate text-[0.75rem] text-muted">{host}</span>}
    </div>
    {
      heroImage && (
        <Image
          src={heroImage}
          alt={heroAlt ?? ''}
          widths={[480, 800, 1200]}
          sizes={large ? '(min-width: 768px) 58vw, 100vw' : '(min-width: 768px) 45vw, 100vw'}
          class="aspect-[16/10] w-full object-cover object-top transition-transform duration-700 ease-[var(--ease-out-soft)] group-hover:scale-[1.02]"
        />
      )
    }
  </div>
  <div class:list={['mt-6', large && 'md:col-span-5 md:mt-0']}>
    <p class="label">{client} · {industry}</p>
    <h3 class:list={['title mt-3', large ? 'text-step-3' : 'text-step-2', compact && 'line-clamp-2 min-h-[2.3em]']}>
      <a href={href} {...(external ? { target: '_blank', rel: 'noopener' } : {})} class="after:absolute after:inset-0 group-hover:text-accent transition-colors">
        {title}{external && <span class="sr-only"> (opens {host})</span>}
      </a>
    </h3>
    <p class:list={['mt-3 text-muted', compact && 'line-clamp-2']}>{summary}</p>
    {
      !compact && services.length > 0 && (
        <ul class="relative z-10 mt-5 flex flex-wrap gap-2" aria-label="Services">
          {services.map((s) => <li><a href={s.href} class="inline-block rounded-full border border-line px-3 py-1 text-step--1 transition-colors hover:border-ink">{s.title}</a></li>)}
        </ul>
      )
    }
  </div>
</article>
