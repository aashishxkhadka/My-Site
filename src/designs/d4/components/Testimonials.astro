---
/**
 * Client testimonials (real words only, see src/content/testimonials.yaml).
 *   bento: homepage. Mixed tiles: featured quote, stat from a review, 5-star count,
 *          quote tiles, reviewer logos, businesses-worked-with.
 *   mini:  service pages and About. Dark featured quote, with the Google rating and up to two quotes stacked beside it.
 *
 * Bento on large screens (4 columns):
 *   F F H R      F featured · H social views stat · R Google rating
 *   F F A A      A–E quotes
 *   B C D D      W "worked with 60+ businesses" + client logos + CTA
 *   W W E E
 */
import { getCollection, getEntry, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import SectionHeader from './SectionHeader.astro';
import TestimonialPerson from './TestimonialPerson.astro';
import TestimonialWork from './TestimonialWork.astro';
import { SOCIALS, STATS } from '@/site.config';

export interface Props {
  items: CollectionEntry<'testimonials'>[];
  layout?: 'bento' | 'mini';
  title?: string;
}
const { items, layout = 'mini', title = 'What clients say.' } = Astro.props;
const google = SOCIALS.find((s) => s.key === 'gbp')?.url;
const clients = new Map(await Promise.all(items.map(async (t) => [t.id, t.data.client ? await getEntry(t.data.client) : undefined] as const)));
const action = google ? { action: { label: 'Read reviews on Google', href: google } } : {};

// Bento slots
const [featured, ...quotes] = items;
const allClients = await getCollection('clients');
// Logo stack on the "worked with" tile: featured clients first.
const logos = allClients.filter((c) => c.data.logo).sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || a.data.order - b.data.order).slice(0, 5);
// Mini: the featured tile spans the rating row plus one row per side quote.
const miniRows = ['lg:row-span-1', 'lg:row-span-2', 'lg:row-span-3'][Math.min(quotes.length, 2)];
const quoteSlots = [
  'col-span-2', // A: wide, beside the featured tile
  'col-span-2 lg:col-span-1', // B
  'col-span-2 hidden sm:block lg:col-span-1', // C
  'col-span-2 hidden sm:block', // D: wide
  'col-span-2 hidden sm:block', // E: wide
  // Phones show the featured quote, A and B (C–E are left out to keep the section short).
];
const tile = 'scroll-in rounded-3xl border border-line p-6 md:p-7';
---

{
  layout === 'bento' ? (
    <section class="wrap pt-24 md:pt-36" aria-labelledby="testimonials">
      <SectionHeader id="testimonials" kicker="Testimonials" title={title} {...action} />
      <ul class="grid grid-cols-2 gap-4 lg:grid-cols-4">
        {featured && (
          <li class={`${tile} stage col-span-2 flex flex-col justify-between gap-10 border-transparent md:p-10 lg:row-span-2`}>
            <figure class="flex h-full flex-col justify-between gap-10">
              <div>
                <svg class="h-10 w-12 text-accent" viewBox="0 0 56 44" fill="currentColor" aria-hidden="true"><path d="M0 44V26.4C0 11.9 7.2 3.1 21.6 0l2.6 5.6C16.5 8 12.6 12.7 12.4 19.6H22V44H0Zm33.6 0V26.4C33.6 11.9 40.8 3.1 55.2 0l2.6 5.6c-7.7 2.4-11.6 7.1-11.8 14H56V44H33.6Z" /></svg>
                <blockquote class="mt-8">
                  <p class="display text-step-2 leading-[1.15]">{featured.data.quote}</p>
                </blockquote>
                <TestimonialWork item={featured} />
              </div>
              <figcaption><TestimonialPerson item={featured} client={clients.get(featured.id)} /></figcaption>
            </figure>
          </li>
        )}

        <li class={`${tile} flex flex-col justify-between gap-6 border-transparent bg-accent text-on-accent`}>
          <p class="display text-[clamp(2.5rem,6vw,4rem)] leading-none">{STATS.socialViews}</p>
          <div>
            <p class="font-semibold">views on social media</p>
            <p class="font-semibold">+ millions of website visits</p>
            <p class="mt-1 text-step--1 opacity-80">Across our clients’ channels</p>
          </div>
        </li>

        <li class={`${tile} group relative flex flex-col justify-between gap-6 bg-paper`}>
          <p class="flex gap-1 text-accent" aria-hidden="true">
            {Array.from({ length: 5 }, () => (
              <svg class="size-5" viewBox="0 0 20 20" fill="currentColor"><path d="M10 1.5l2.6 5.3 5.9.9-4.25 4.1 1 5.85L10 14.9l-5.25 2.75 1-5.85L1.5 7.7l5.9-.9z" /></svg>
            ))}
          </p>
          <div>
            <p class="display text-[clamp(2.5rem,6vw,4rem)] leading-none">{STATS.googleRating.toFixed(1)}</p>
            <p class="mt-2 font-semibold">
              {google ? (
                <a href={google} target="_blank" rel="noopener" class="after:absolute after:inset-0 group-hover:text-accent">star rating on Google</a>
              ) : (
                'star rating on Google'
              )}
            </p>
          </div>
        </li>

        {quotes.slice(0, 3).map((t, i) => (
          <li class={`${tile} ${quoteSlots[i]} bg-paper`}>
            <figure class="flex h-full flex-col justify-between gap-6">
              <div>
                <blockquote><p class:list={['leading-relaxed', i === 0 ? 'text-step-1 leading-snug' : 'text-[1.0625rem]']}>“{t.data.quote}”</p></blockquote>
                <TestimonialWork item={t} />
              </div>
              <figcaption><TestimonialPerson item={t} client={clients.get(t.id)} /></figcaption>
            </figure>
          </li>
        ))}

        {quotes[3] && (
          <li class={`${tile} ${quoteSlots[3]} bg-paper`}>
            <figure class="flex h-full flex-col justify-between gap-6">
              <div>
                <blockquote><p class="text-step-1 leading-snug">“{quotes[3].data.quote}”</p></blockquote>
                <TestimonialWork item={quotes[3]} />
              </div>
              <figcaption><TestimonialPerson item={quotes[3]} client={clients.get(quotes[3].id)} /></figcaption>
            </figure>
          </li>
        )}

        <li class={`${tile} stage relative col-span-2 overflow-hidden border-transparent md:p-10 ${quotes[4] ? '' : 'lg:col-span-4'}`}>
          <div class="pointer-events-none absolute -right-16 -top-24 size-72 rounded-full bg-accent/25 blur-3xl" aria-hidden="true" />
          <div class="relative flex h-full flex-col justify-between gap-8">
            <div class="flex -space-x-3" aria-hidden="true">
              {logos.map((c) => (
                <span class:list={['grid size-14 place-items-center overflow-hidden rounded-full p-2 ring-4 ring-[#1c1c1c]', c.data.logoOnDark ? 'bg-[#111]' : 'bg-white']}>
                  <Image src={c.data.logo!} alt="" widths={[112]} sizes="56px" class="max-h-full w-full object-contain" />
                </span>
              ))}
              <span class="grid size-14 place-items-center rounded-full bg-accent text-step--1 font-bold text-on-accent ring-4 ring-[#1c1c1c]">+{STATS.businessesWorkedWith - logos.length}</span>
            </div>
            <div class="flex flex-wrap items-end justify-between gap-6">
              <p class="display text-step-3 leading-[1.05]">
                Worked with <span class="text-accent">{STATS.businessesWorkedWith}+</span><br />businesses.
              </p>
              <a href="/contact/" class="inline-flex items-center gap-2 rounded-full bg-accent px-5 py-3 font-semibold text-on-accent transition-opacity hover:opacity-90">
                Be the next <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        </li>

        {quotes[4] && (
          <li class={`${tile} ${quoteSlots[4]} bg-paper`}>
            <figure class="flex h-full flex-col justify-between gap-6">
              <div>
                <blockquote><p class="text-step-1 leading-snug">“{quotes[4].data.quote}”</p></blockquote>
                <TestimonialWork item={quotes[4]} />
              </div>
              <figcaption><TestimonialPerson item={quotes[4]} client={clients.get(quotes[4].id)} /></figcaption>
            </figure>
          </li>
        )}
      </ul>
    </section>
  ) : (
    <section class="wrap pt-24 md:pt-32" aria-labelledby="testimonials">
      <SectionHeader id="testimonials" kicker="Testimonials" title={title} {...action} />
      <ul class="grid gap-4 lg:grid-cols-5">
        {featured && (
          <li class:list={[tile, 'stage flex flex-col border-transparent md:p-10 lg:col-span-3', miniRows]}>
            <figure class="flex h-full flex-col justify-between gap-10">
              <div>
                <svg class="h-9 w-11 text-accent" viewBox="0 0 56 44" fill="currentColor" aria-hidden="true"><path d="M0 44V26.4C0 11.9 7.2 3.1 21.6 0l2.6 5.6C16.5 8 12.6 12.7 12.4 19.6H22V44H0Zm33.6 0V26.4C33.6 11.9 40.8 3.1 55.2 0l2.6 5.6c-7.7 2.4-11.6 7.1-11.8 14H56V44H33.6Z" /></svg>
                <blockquote class="mt-7">
                  <p class="display text-step-2 leading-[1.2]">{featured.data.quote}</p>
                </blockquote>
              </div>
              <figcaption>
                <TestimonialPerson item={featured} client={clients.get(featured.id)} class="mb-5" />
                <div class="border-t border-line pt-1 [&>p]:mt-4"><TestimonialWork item={featured} /></div>
              </figcaption>
            </figure>
          </li>
        )}

        <li class={`${tile} group relative flex items-center gap-5 bg-paper lg:col-span-2`}>
          <p class="display text-[clamp(2.5rem,5vw,3.5rem)] leading-none">{STATS.googleRating.toFixed(1)}</p>
          <div>
            <p class="flex gap-0.5 text-accent" aria-hidden="true">
              {Array.from({ length: 5 }, () => (
                <svg class="size-4" viewBox="0 0 20 20" fill="currentColor"><path d="M10 1.5l2.6 5.3 5.9.9-4.25 4.1 1 5.85L10 14.9l-5.25 2.75 1-5.85L1.5 7.7l5.9-.9z" /></svg>
              ))}
            </p>
            <p class="mt-1.5 font-semibold">
              {google ? <a href={google} target="_blank" rel="noopener" class="after:absolute after:inset-0 group-hover:text-accent">star rating on Google</a> : 'star rating on Google'}
            </p>
          </div>
        </li>

        {quotes.slice(0, 2).map((t) => (
          <li class={`${tile} bg-paper lg:col-span-2`}>
            <figure class="flex h-full flex-col justify-between gap-5">
              <div>
                <blockquote><p class="text-[1.0625rem] leading-relaxed">“{t.data.quote}”</p></blockquote>
                <TestimonialWork item={t} />
              </div>
              <figcaption><TestimonialPerson item={t} client={clients.get(t.id)} /></figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </section>
  )
}
