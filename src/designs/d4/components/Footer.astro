---
import { NAV, SITE, SOCIALS, CONTACT, BASILPOT } from '@/site.config';
import { emptySectionHrefs } from '@/lib/taxonomy';

const year = new Date().getFullYear();
const socials = SOCIALS.filter((s) => s.visible && s.url);
const isExternal = (href: string) => /^https?:\/\//.test(href);
// Writing sections with nothing published yet stay out of the footer.
const hidden = await emptySectionHrefs();
const groups = NAV.footer.map((g) => ({ ...g, links: g.links.filter((l) => !hidden.includes(l.href)) }));
---

<footer class="border-t border-line">
  <div class="wrap grid gap-12 py-16 md:grid-cols-12">
    <div class="md:col-span-5">
      <p class="title text-step-2">{SITE.name}</p>
      <p class="mt-2 max-w-sm text-muted">
        Founder of <a class="link" href={BASILPOT.url}>Basilpot</a>. Helping businesses in Nepal and abroad grow with strategy, marketing, brand and web.
      </p>
      <address class="mt-6 space-y-1 not-italic">
        <p>{CONTACT.address.display}</p>
        <p><a class="link -my-2 inline-block py-2" href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></p>
        <p><a class="link -my-2 inline-block py-2" href={`tel:${CONTACT.phoneE164}`}>{CONTACT.phoneDisplay}</a></p>
      </address>
      {
        socials.length > 0 && (
          <ul class="mt-6 flex flex-wrap gap-2" aria-label="Elsewhere">
            {socials.map((s) => (
              <li>
                <a class="inline-block rounded-full border border-line px-4 py-1.5 text-step--1 font-medium transition-colors hover:border-ink" href={s.url} rel="me noopener" target="_blank">
                  {s.label}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>

    <nav aria-label="Footer" class="grid grid-cols-2 grid-rows-[auto_1fr] items-start gap-x-8 gap-y-8 sm:grid-cols-3 sm:grid-rows-none md:col-span-7">
      {
        groups.map((group, i) => (
          <div class:list={[i === 0 && 'max-sm:row-span-2']}>
            <p class="label mb-4">{group.heading}</p>
            <ul class="space-y-2.5 text-[0.9375rem]">
              {group.links.map((l) => (
                <li>
                  <a class="-my-2 inline-block py-2 text-muted transition-colors hover:text-ink" href={l.href} {...(isExternal(l.href) ? { rel: 'noopener', target: '_blank' } : {})}>
                    {l.label}
                    {isExternal(l.href) && <span aria-hidden="true"> ↗</span>}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>
  </div>
  <div class="wrap flex flex-col gap-3 border-t border-line py-6 text-step--1 text-muted sm:flex-row sm:items-center sm:justify-between">
    <p class="flex flex-wrap items-center gap-x-2">
      <span>© {year} {SITE.name}</span>
      <span aria-hidden="true">·</span>
      <a href={BASILPOT.url} target="_blank" rel="noopener" class="grown group -my-2 inline-flex items-center gap-1.5 py-2 hover:text-ink">
        Grown at <span class="font-semibold text-ink">Basilpot</span>
        <span class="sprout" aria-hidden="true"><span>🌱</span><span>🌿</span></span>
      </a>
    </p>
    <ul class="flex gap-5">
      {NAV.legal.map((l) => <li><a class="-my-3 inline-block py-3 hover:text-ink" href={l.href}>{l.label}</a></li>)}
    </ul>
  </div>
</footer>

<style>
  /* "Grown at Basilpot": on hover the sprout grows into a full plant. */
  .sprout { position: relative; display: inline-block; width: 1.1em; height: 1.1em; line-height: 1.1em; }
  .sprout > span { position: absolute; inset: 0; transform-origin: 50% 100%; transition: transform 500ms cubic-bezier(0.34, 1.56, 0.64, 1), opacity 300ms; }
  .sprout > span:last-child { opacity: 0; transform: scale(0.4); }
  .grown:hover .sprout > span:first-child, .grown:focus-visible .sprout > span:first-child { opacity: 0; transform: scale(0.4); }
  .grown:hover .sprout > span:last-child, .grown:focus-visible .sprout > span:last-child { opacity: 1; transform: scale(1.15); }
  @media (prefers-reduced-motion: reduce) { .sprout > span { transition: none; } }
</style>
