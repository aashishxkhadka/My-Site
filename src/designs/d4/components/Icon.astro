---
/** Small line icons (24×24, stroke = currentColor). Decorative: always aria-hidden. */
import { PATHS, type IconName } from '../icons';
export type { IconName };

export interface Props {
  name: IconName;
  class?: string;
}
const { name, class: className = 'size-6' } = Astro.props;
---

<svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={PATHS[name]} /></svg>
