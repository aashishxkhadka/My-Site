---
import type { MarkdownHeading } from 'astro';

export interface Props {
  headings: MarkdownHeading[];
  /** Closed by default and main headings only (native <details>, no JS). */
  collapsible?: boolean | undefined;
}
const { headings, collapsible } = Astro.props;
---

{
  headings.length > 0 && collapsible && (
    <details class="toc group rounded-2xl border border-line">
      <summary class="label flex cursor-pointer list-none items-center justify-between gap-6 px-5 py-4">
        On this page
        <span class="transition-transform duration-300 group-open:rotate-180" aria-hidden="true">▾</span>
      </summary>
      <ol class="space-y-1 px-5 pb-4 text-step--1">
        {headings.filter((h) => h.depth === 2).map((h) => (
          <li><a class="block py-1 text-muted transition-colors hover:text-ink" href={`#${h.slug}`}>{h.text}</a></li>
        ))}
      </ol>
    </details>
  )
}
{
  headings.length > 0 && !collapsible && (
    <nav aria-labelledby="toc-title" class="rounded-2xl border border-line p-5">
      <p id="toc-title" class="label">On this page</p>
      <ol class="mt-4 space-y-2 text-step--1">
        {headings.map((h) => (
          <li class:list={[h.depth === 3 && 'pl-4']}>
            <a class="text-muted transition-colors hover:text-ink" href={`#${h.slug}`}>{h.text}</a>
          </li>
        ))}
      </ol>
    </nav>
  )
}

<style>
  .toc summary::-webkit-details-marker { display: none; }
</style>
