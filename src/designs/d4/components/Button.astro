---
export interface Props {
  href: string;
  variant?: 'primary' | 'outline';
  class?: string;
  [key: string]: unknown;
}
const { href, variant = 'primary', class: className = '', ...rest } = Astro.props;
---

<a
  href={href}
  class:list={[
    'group inline-flex items-center gap-2.5 rounded-full px-6 py-3.5 font-semibold transition-[opacity,border-color,background-color]',
    variant === 'primary' ? 'bg-accent text-on-accent hover:opacity-90' : 'border border-line text-ink hover:border-ink',
    className,
  ]}
  {...rest}
>
  <slot />
  <span aria-hidden="true" class="transition-transform duration-300 group-hover:translate-x-1">→</span>
</a>
