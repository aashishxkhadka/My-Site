---
/**
 * d5 homepage: d4 "Editorial" with a redesigned, layered portrait hero — answers, in order:
 *   1. Who I am (portrait hero)  2. What I deliver (services)  3. How to work with me (CTA)
 * with proof in between: client brands, selected work, products, writing.
 * Sections with no published content are omitted rather than shown empty.
 */
import { Picture } from 'astro:assets';
import BaseLayout from '../d4/Layout.astro';
import Hero from './components/Hero.astro';
import Button from '../d4/components/Button.astro';
import SectionHeader from '../d4/components/SectionHeader.astro';
import ServiceItem from '../d4/components/ServiceItem.astro';
import WorkCard from '../d4/components/WorkCard.astro';
import ProductCard from '../d4/components/ProductCard.astro';
import ClientWall from '../d4/components/ClientWall.astro';
import PostCard from '../d4/components/PostCard.astro';
import Testimonials from '../d4/components/Testimonials.astro';
import Faq from '../d4/components/Faq.astro';
import { HOW_I_WORK, HOME_FAQ } from '@/data/home';
import { faqNode } from '@/lib/schema';
import portrait from '@/assets/aashish.jpg';
import { getCollection } from 'astro:content';
import { getPublished, byNewest, byOrder, latestDate } from '@/lib/content';
import { SITE, CONTACT, BASILPOT } from '@/site.config';

export interface Props {
  /** True on /designs/<id>/ previews. */
  noindex?: boolean;
}
const { noindex = false } = Astro.props;

const allServices = (await getPublished('services')).sort(byOrder);
const services = allServices.filter((s) => s.data.featured).slice(0, 5);
const work = (await getPublished('work')).filter((w) => w.data.featured).sort(byOrder).slice(0, 3);
const projects = (await getPublished('projects')).sort(byOrder);
const posts = (await getPublished('blog')).sort(byNewest).slice(0, 3); // always the latest three
const clients = (await getCollection('clients')).sort(byOrder);
// Homepage shows a curated row (featured: true in clients.yaml); the full wall lives on /work/.
const featuredClients = clients.filter((c) => c.data.logo && c.data.featured).slice(0, 10);
// One line of products here; the full list lives on /projects/.
const productRow = projects.slice(0, 4);

// Homepage reviews: featured: true in testimonials.yaml, in order.
const testimonials = (await getPublished('testimonials')).filter((t) => t.data.featured).sort(byOrder).slice(0, 7);

---

<BaseLayout rawTitle={SITE.defaultTitle} description={SITE.defaultDescription} noindex={noindex} lastModified={latestDate(posts)} schema={[faqNode('/', HOME_FAQ)]}>
  <!-- 1 · Who I am -->
  <Hero clients={clients} />

  <!-- Proof · Client brands -->
  {
    clients.length > 0 && (
      <section class="wrap pt-24 md:pt-32" aria-labelledby="clients">
        <SectionHeader
          id="clients"
          kicker="Clients"
          title="Brands I've helped grow."
          lead="Through Basilpot: websites, digital marketing and media for clinics, schools, restaurants, resorts and more, in Nepal and abroad."
        />
        <ClientWall clients={featuredClients} mobileLimit={6} />
        <div class="mt-10 flex justify-center">
          <Button href="/work/#clients" variant="outline">Explore Clients</Button>
        </div>
      </section>
    )
  }

  <!-- 2 · What I deliver -->
  {
    services.length > 0 && (
      <section class="wrap pt-24 md:pt-36" aria-labelledby="services">
        <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-5">
            <div class="lg:sticky lg:top-28">
              <p class="label mb-4 flex items-center gap-3"><span class="h-px w-8 bg-accent" aria-hidden="true" />Services</p>
              <h2 id="services" class="display text-step-4">How I help businesses grow.</h2>
              <p class="mt-6 max-w-md text-step-1 leading-snug text-muted">
                Growth rarely comes from one tactic. It comes from knowing who you serve, telling them clearly, and showing up where they look. I work across all of it, so nothing falls between the gaps.
              </p>
              <div class="mt-8 flex flex-wrap gap-3">
                <Button href="/contact/">Talk to me</Button>
                <Button href="/services/" variant="outline">All services</Button>
              </div>
            </div>
          </div>
          <div class="border-b border-line lg:col-span-7">
            {services.map((s, i) => (
              <ServiceItem service={s} index={i} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- How we'd work together -->
  <section class="wrap pt-24 md:pt-36" aria-labelledby="process">
    <SectionHeader id="process" kicker="Process" title="How we'd work together." lead="Simple and clear, so you always know what's happening and why." />
    <ol class="grid gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
      {HOW_I_WORK.map((step, i) => (
        <li class="flex flex-col bg-paper p-7 md:p-8">
          <span class="display text-step-3 text-accent" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="title mt-6 text-step-1">{step.title}</h3>
          <p class="mt-2 text-muted">{step.description}</p>
        </li>
      ))}
    </ol>
    <div class="mt-10 flex justify-center">
      <Button href="/contact/">Start with a conversation</Button>
    </div>
  </section>

  <!-- Quote -->
  <section class="wrap pt-24 md:pt-36" aria-label="How I work">
    <figure class="stage scroll-in relative overflow-hidden rounded-[2rem] border border-line px-6 py-14 md:px-16 md:py-20">
      <svg class="mb-8 h-10 w-12 text-accent md:h-12 md:w-14" viewBox="0 0 56 44" fill="currentColor" aria-hidden="true"><path d="M0 44V26.4C0 11.9 7.2 3.1 21.6 0l2.6 5.6C16.5 8 12.6 12.7 12.4 19.6H22V44H0Zm33.6 0V26.4C33.6 11.9 40.8 3.1 55.2 0l2.6 5.6c-7.7 2.4-11.6 7.1-11.8 14H56V44H33.6Z"/></svg>
      <p class="label relative mb-6 flex items-center gap-3 text-ink"><span class="h-px w-8 bg-accent" aria-hidden="true"></span>Consistency</p>
      <blockquote class="relative max-w-4xl [container-type:inline-size]">
        <!-- Each sentence starts a new line. Phones: full size, wrapping. Tablet up: one line each, scaled to fit the box. -->
        <p class="display text-step-3 leading-[1.12] md:text-[min(var(--text-step-3),3.8cqi)]">
          <span class="block md:whitespace-nowrap">Growth isn't about one big move.</span>
          <span class="mt-2 block md:mt-0 md:whitespace-nowrap">It's about doing the small things right, every day.</span>
        </p>
      </blockquote>
      <figcaption class="relative mt-10 flex items-center gap-4">
        <Picture src={portrait} alt="" formats={['avif', 'webp']} widths={[112]} sizes="56px" class="size-14 rounded-full object-cover object-[50%_18%]" />
        <span>
          <span class="title block">Aashish Khadka</span>
          <span class="text-step--1 text-muted">Founder, <a class="link" href={BASILPOT.url}>Basilpot</a></span>
        </span>
      </figcaption>
    </figure>
  </section>

  <!-- Proof · Selected work -->
  {
    work.length > 0 && (
      <section id="work" class="wrap pt-24 md:pt-36" aria-labelledby="work-title">
        <SectionHeader id="work-title" kicker="Selected work" title="Recent work." />
        <div class="grid gap-14 sm:grid-cols-2 sm:gap-8 lg:grid-cols-3">
          {work.map((w) => (
            <WorkCard item={w} compact />
          ))}
        </div>
        <div class="mt-12 flex justify-center">
          <Button href="/work/" variant="outline">View all work</Button>
        </div>
      </section>
    )
  }

  <!-- Proof · Testimonials (hidden until real ones are added) -->
  {testimonials.length > 0 && <Testimonials items={testimonials} layout="bento" />}

  <!-- Proof · Products -->
  {
    projects.length > 0 && (
      <section class="pt-24 md:pt-36" aria-labelledby="products">
        <div class="wrap">
          <SectionHeader id="products" kicker="Products" title="Built at Basilpot." lead="Alongside client work, we build and run products of our own." />
        </div>
        <ul class="product-row wrap flex snap-x snap-mandatory gap-5 overflow-x-auto pb-2 lg:grid lg:snap-none lg:grid-cols-4 lg:gap-6 lg:overflow-visible">
          {productRow.map((p) => (
            <li class="w-[78%] shrink-0 snap-start sm:w-[44%] lg:w-auto">
              <ProductCard project={p} />
            </li>
          ))}
        </ul>
        <div class="wrap mt-12 flex flex-wrap justify-center gap-3">
          <Button href="/projects/" variant="outline">View Projects</Button>
        </div>
      </section>
    )
  }

  <!-- Proof · Writing -->
  {
    posts.length > 0 && (
      <section class="wrap pt-24 md:pt-36" aria-labelledby="writing">
        <SectionHeader id="writing" kicker="Writing" title="Notes on growth." lead="The latest from the blog." />
        <ul class="grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
          {posts.map((p) => (
            <li><PostCard post={p} /></li>
          ))}
        </ul>
        <div class="mt-12 flex justify-center">
          <Button href="/blog/" variant="outline">Read all posts</Button>
        </div>
      </section>
    )
  }

  <!-- FAQ (also FAQPage structured data) -->
  <div class="wrap pt-24 md:pt-36"><Faq items={HOME_FAQ} title="Questions people ask." /></div>

  <!-- 3 · How to work with me -->
  <section class="wrap py-24 md:py-36" aria-labelledby="cta">
    <div class="stage relative grid overflow-hidden rounded-[2rem] border border-line md:grid-cols-12">
      <div class="relative z-10 px-6 py-14 md:col-span-7 md:px-16 md:py-20">
        <p class="label mb-4 flex items-center gap-3 text-ink"><span class="h-px w-8 bg-accent" aria-hidden="true"></span>Work with me</p>
        <h2 id="cta" class="display text-step-4">Let's grow your business.</h2>
        <p class="mt-6 max-w-md text-step-1 leading-snug text-muted">
          Tell me where your business is today and where you want it to be. I'll tell you honestly how I can help.
        </p>
        <div class="mt-9 flex flex-wrap gap-3">
          <Button href="/contact/">Start a conversation</Button>
        </div>
        <div class="mt-10 flex flex-col gap-1 sm:flex-row sm:gap-8">
          <a class="link font-medium" href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
          <a class="link font-medium" href={`tel:${CONTACT.phoneE164}`}>{CONTACT.phoneDisplay}</a>
        </div>
      </div>
      <div class="relative hidden md:col-span-5 md:block" aria-hidden="true">
        <Picture src={portrait} alt="" formats={['avif', 'webp']} widths={[500, 716]} sizes="35vw" class="cta-portrait absolute bottom-0 right-[4%] h-[90%] w-auto max-w-none object-contain object-bottom" />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hide the scrollbar on the swipeable product row; it stays scrollable and keyboard-focusable. */
  .product-row { scrollbar-width: none; scroll-padding-inline: clamp(1.25rem, 4vw, 3rem); }
  .product-row::-webkit-scrollbar { display: none; }
  .cta-portrait {
    -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 38%, #000 74%, transparent 100%), linear-gradient(to bottom, transparent 0%, #000 22%, #000 100%);
    -webkit-mask-composite: source-in;
    mask-image: linear-gradient(to right, transparent 0%, #000 38%, #000 74%, transparent 100%), linear-gradient(to bottom, transparent 0%, #000 22%, #000 100%);
    mask-composite: intersect;
  }
</style>
