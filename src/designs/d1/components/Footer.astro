---
import { NAV, SITE, SOCIALS, CONTACT } from '@/site.config';

const year = new Date().getFullYear();
const socials = SOCIALS.filter((s) => s.visible && s.url);
const isExternal = (href: string) => /^https?:\/\//.test(href);
---

<footer class="mt-24 border-t border-line">
  <div class="wrap grid gap-12 py-16 md:grid-cols-12">
    <div class="md:col-span-5">
      <p class="text-step-1 font-bold tracking-[-0.03em]">{SITE.name}</p>
      <address class="mt-4 space-y-1 not-italic text-muted">
        <p>{CONTACT.address.display}</p>
        <p><a class="link" href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></p>
        <p><a class="link" href={`tel:${CONTACT.phoneE164}`}>{CONTACT.phoneDisplay}</a></p>
      </address>
      {
        socials.length > 0 && (
          <ul class="mt-6 flex flex-wrap gap-2" aria-label="Elsewhere">
            {socials.map((s) => (
              <li>
                <a
                  class="inline-block rounded-md border border-line px-3 py-1.5 text-step--1 font-medium text-muted transition-colors hover:border-ink hover:text-ink"
                  href={s.url}
                  rel="me noopener"
                  target="_blank"
                >
                  {s.label}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>

    <nav aria-label="Footer" class="grid grid-cols-2 gap-8 sm:grid-cols-3 md:col-span-7">
      {
        NAV.footer.map((group) => (
          <div>
            <p class="label mb-4 text-ink">{group.heading}</p>
            <ul class="space-y-2.5 text-[0.9375rem]">
              {group.links.map((l) => (
                <li>
                  <a
                    class="text-muted transition-colors hover:text-ink"
                    href={l.href}
                    {...(isExternal(l.href) ? { rel: 'noopener', target: '_blank' } : {})}
                  >
                    {l.label}
                    {isExternal(l.href) && <span aria-hidden="true"> ↗</span>}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>
  </div>

  <div class="wrap flex flex-col gap-3 border-t border-line py-6 text-step--1 text-muted sm:flex-row sm:items-center sm:justify-between">
    <p>© {year} {SITE.name}</p>
    <ul class="flex gap-5">
      {NAV.legal.map((l) => <li><a class="hover:text-ink" href={l.href}>{l.label}</a></li>)}
    </ul>
  </div>
</footer>
