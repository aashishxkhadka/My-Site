---
/** Section heading: big headline left, optional action right. */
export interface Props {
  id: string;
  title: string;
  lead?: string;
  action?: { label: string; href: string } | undefined;
}
const { id, title, lead, action } = Astro.props;
---

<div class="mb-10 flex flex-col gap-6 md:mb-14 md:flex-row md:items-end md:justify-between">
  <div class="max-w-3xl">
    <h2 id={id} class="headline text-step-4">{title}</h2>
    {lead && <p class="mt-5 max-w-xl text-step-1 leading-snug text-muted">{lead}</p>}
  </div>
  {
    action && (
      <a href={action.href} class="group inline-flex shrink-0 items-center gap-2 font-semibold">
        {action.label}
        <span aria-hidden="true" class="transition-transform duration-300 group-hover:translate-x-1">→</span>
      </a>
    )
  }
</div>
