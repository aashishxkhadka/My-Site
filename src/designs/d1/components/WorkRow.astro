---
import type { CollectionEntry } from 'astro:content';

export interface Props {
  item: CollectionEntry<'work'>;
  serviceTitles: string[];
}
const { item, serviceTitles } = Astro.props;
const lead = item.data.results[0];
---

<article class="group relative grid gap-4 border-b border-line py-8 md:grid-cols-12 md:items-center md:gap-8 md:py-10">
  <div class="md:col-span-8">
    <p class="label">
      {item.data.client ?? 'Confidential client'} · {item.data.industry}
    </p>
    <h3 class="title mt-3 text-step-3">
      <a href={`/work/${item.id}/`} class="after:absolute after:inset-0 transition-colors group-hover:text-accent">{item.data.title}</a>
    </h3>
    <p class="mt-3 max-w-2xl text-muted">{item.data.summary}</p>
    <ul class="mt-5 flex flex-wrap gap-2" aria-label="Services">
      {serviceTitles.map((t) => <li class="rounded-md bg-surface px-2.5 py-1 text-step--1 font-medium">{t}</li>)}
    </ul>
  </div>
  {
    lead && (
      <div class="md:col-span-3 md:text-right">
        <p class="headline text-step-4 text-accent">{lead.value}</p>
        <p class="label mt-2">{lead.label}</p>
      </div>
    )
  }
  <span aria-hidden="true" class="hidden text-step-2 transition-transform duration-300 group-hover:translate-x-1 md:col-span-1 md:block md:text-right">→</span>
</article>
