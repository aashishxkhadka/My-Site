---
import { NAV, SITE } from '@/site.config';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="sticky top-0 z-40 border-b border-line bg-bg/80 backdrop-blur-xl">
  <div class="wrap flex h-16 items-center justify-between gap-6">
    <!-- TODO(brand): swap for aashish-khadka-logo.svg once provided. -->
    <a href="/" class="text-[1.0625rem] font-bold tracking-[-0.03em]" aria-label={`${SITE.name}, home`}>
      Aashish Khadka
    </a>

    <div class="flex items-center gap-2">
      <nav aria-label="Main" class="hidden md:block">
        <ul class="flex items-center text-[0.9375rem] font-medium">
          {
            NAV.primary.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                  class="px-3 py-2 text-muted transition-colors hover:text-ink aria-[current=page]:text-ink"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <ThemeToggle />
      <a
        href={NAV.cta.href}
        class="hidden rounded-md bg-accent px-4 py-2 text-[0.9375rem] font-semibold text-on-accent transition-colors hover:bg-accent-hover md:inline-block"
      >
        {NAV.cta.label}
      </a>
      <button
        type="button"
        popovertarget="mobile-nav"
        class="inline-grid size-10 place-items-center rounded-md hover:bg-surface md:hidden"
        aria-label="Open menu"
      >
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M4 8h16M4 16h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu: native popover. No framework JS; Esc and light-dismiss built in. -->
  <div id="mobile-nav" popover class="mobile-nav m-0 h-dvh max-h-none w-full max-w-none bg-bg p-0 text-ink">
    <div class="wrap flex h-16 items-center justify-between border-b border-line">
      <span class="text-[1.0625rem] font-bold tracking-[-0.03em]">Aashish Khadka</span>
      <button
        type="button"
        popovertarget="mobile-nav"
        popovertargetaction="hide"
        class="inline-grid size-10 place-items-center rounded-md hover:bg-surface"
        aria-label="Close menu"
      >
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>
    <nav aria-label="Main mobile" class="wrap pt-4">
      <ul>
        {
          NAV.primary.map((item) => (
            <li class="border-b border-line">
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class="flex items-center justify-between py-4 text-step-3 headline aria-[current=page]:text-accent"
              >
                {item.label}
                <span aria-hidden="true" class="text-step-1 text-muted">→</span>
              </a>
            </li>
          ))
        }
      </ul>
      <a href={NAV.cta.href} class="mt-8 flex justify-center rounded-md bg-accent px-5 py-4 font-semibold text-on-accent">
        {NAV.cta.label}
      </a>
    </nav>
  </div>
</header>

<style>
  .mobile-nav { inset: 0; border: 0; }
  .mobile-nav::backdrop { background: transparent; }
  @media (prefers-reduced-motion: no-preference) {
    .mobile-nav:popover-open { animation: menu-in 240ms var(--ease-out-soft); }
  }
  @keyframes menu-in {
    from { opacity: 0; transform: translateY(-12px); }
  }
</style>
