---
import type { CollectionEntry } from 'astro:content';
import { TOPICS } from '@/site.config';
import { formatDate, isoDate } from '@/lib/format';

export interface Props {
  post: CollectionEntry<'blog'>;
}
const { post } = Astro.props;
const topic = TOPICS.find((t) => t.key === post.data.topics[0]);
---

<article class="group relative flex flex-col gap-2 border-b border-line py-6 md:flex-row md:items-baseline md:justify-between md:gap-10">
  <h3 class="title text-step-2 md:max-w-3xl">
    <a href={`/blog/${post.id}/`} class="after:absolute after:inset-0 transition-colors group-hover:text-accent">{post.data.title}</a>
  </h3>
  <p class="label shrink-0">
    {topic && <>{topic.label} · </>}<time datetime={isoDate(post.data.pubDate)}>{formatDate(post.data.pubDate)}</time>
  </p>
</article>
