---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

export interface Props {
  project: CollectionEntry<'projects'>;
  /** Eager-load when it's near the top of the page. */
  eager?: boolean;
}
const { project, eager = false } = Astro.props;
const { title, tagline, url, basilpotUrl, status, screenshot, screenshotAlt } = project.data;
const statusLabel = { live: 'Live', beta: 'Beta', 'in-development': 'In development', archived: 'Archived' }[status];
const host = url ? new URL(url).host : undefined;
---

<article class="group relative flex h-full flex-col">
  <div class="aspect-[16/10] overflow-hidden rounded-lg border border-line bg-surface">
    {
      screenshot ? (
        <Image
          src={screenshot}
          alt={screenshotAlt ?? ''}
          widths={[480, 800, 1200]}
          sizes="(min-width: 768px) 50vw, 100vw"
          loading={eager ? 'eager' : 'lazy'}
          class="h-full w-full object-cover object-top transition-transform duration-700 ease-[var(--ease-out-soft)] group-hover:scale-[1.03] motion-reduce:transition-none"
        />
      ) : (
        <div class="grid h-full place-items-center headline text-step-4 text-muted/40" aria-hidden="true">{title}</div>
      )
    }
  </div>
  <div class="mt-5 flex items-start justify-between gap-4">
    <div>
      <h3 class="title text-step-2">
        {
          url ? (
            <a href={url} target="_blank" rel="noopener" class="after:absolute after:inset-0">{title}</a>
          ) : (
            title
          )
        }
      </h3>
      <p class="mt-1 text-muted"><slot name="tagline">{tagline}</slot></p>
    </div>
    <span class="label inline-flex shrink-0 items-center gap-1.5 rounded-md border border-line px-2 py-1">
      <span class:list={['size-1.5 rounded-full', status === 'live' ? 'bg-[#16a34a]' : 'bg-muted']} aria-hidden="true"></span>
      {statusLabel}
    </span>
  </div>
  <div class="relative z-10 mt-3 flex flex-wrap gap-x-5 text-step--1 font-medium">
    {host && <span class="text-ink">{host} <span aria-hidden="true">↗</span></span>}
    {basilpotUrl && <a class="link text-muted" href={basilpotUrl} target="_blank" rel="noopener">On Basilpot ↗</a>}
  </div>
</article>
