---
/** Endless scrolling band. Second copy is aria-hidden; static under reduced motion. */
export interface Props {
  items: string[];
  class?: string;
}
const { items, class: className = '' } = Astro.props;
---

<div class:list={['marquee overflow-hidden', className]}>
  <div class="track flex w-max">
    {
      [0, 1].map((copy) => (
        <ul class="flex shrink-0 items-center" aria-hidden={copy === 1 ? 'true' : undefined}>
          {items.map((item) => (
            <li class="flex items-center">
              <span class="px-6 md:px-10">{item}</span>
              <span class="text-[0.6em]" aria-hidden="true">✦</span>
            </li>
          ))}
        </ul>
      ))
    }
  </div>
</div>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .track { animation: marquee 40s linear infinite; }
    .marquee:hover .track { animation-play-state: paused; }
  }
  @keyframes marquee { to { transform: translateX(-50%); } }
</style>
