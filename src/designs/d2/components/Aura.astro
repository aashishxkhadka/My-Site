---
/** Slow-drifting gradient light behind a section. Decorative, CSS only. */
export interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<div class:list={['aura pointer-events-none absolute inset-0 -z-10 overflow-hidden', className]} aria-hidden="true">
  <span class="blob b1"></span>
  <span class="blob b2"></span>
  <span class="blob b3"></span>
</div>

<style>
  .aura { opacity: var(--aura-opacity); }
  .blob {
    position: absolute;
    border-radius: 9999px;
    filter: blur(90px);
    will-change: transform;
  }
  .b1 { width: 46vw; height: 46vw; left: 38%; top: -12%; background: var(--g1); }
  .b2 { width: 40vw; height: 40vw; left: 58%; top: 18%; background: var(--g2); }
  .b3 { width: 52vw; height: 52vw; left: 20%; top: 30%; background: var(--g3); opacity: 0.8; }

  @media (prefers-reduced-motion: no-preference) {
    .b1 { animation: drift-a 22s ease-in-out infinite alternate; }
    .b2 { animation: drift-b 26s ease-in-out infinite alternate; }
    .b3 { animation: drift-c 30s ease-in-out infinite alternate; }
  }
  @keyframes drift-a { to { transform: translate(-14vw, 10vh) scale(1.15); } }
  @keyframes drift-b { to { transform: translate(-22vw, -6vh) scale(0.9); } }
  @keyframes drift-c { to { transform: translate(16vw, -12vh) scale(1.1); } }
</style>
