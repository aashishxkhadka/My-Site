---
export interface Props {
  href: string;
  variant?: 'primary' | 'secondary';
  size?: 'md' | 'lg';
  class?: string;
  [key: string]: unknown;
}

const { href, variant = 'primary', size = 'md', class: className = '', ...rest } = Astro.props;
const sizes = { md: 'px-5 py-2.5 text-[0.9375rem]', lg: 'px-7 py-4 text-step-0' };
---

<a
  href={href}
  class:list={[
    'group relative inline-flex items-center gap-2 overflow-hidden rounded-full font-medium',
    variant === 'primary' ? 'bg-ink text-bg' : 'border border-line text-ink transition-colors hover:border-ink',
    sizes[size],
    className,
  ]}
  {...rest}
>
  {
    variant === 'primary' && (
      <span class="bg-gradient absolute inset-0 translate-y-full rounded-full transition-transform duration-500 ease-[var(--ease-out-soft)] group-hover:translate-y-0" aria-hidden="true" />
    )
  }
  <span class:list={['relative', variant === 'primary' && 'group-hover:text-white']}><slot /></span>
  <span aria-hidden="true" class:list={['relative transition-transform duration-500 ease-[var(--ease-spring)] group-hover:translate-x-1', variant === 'primary' && 'group-hover:text-white']}>→</span>
</a>
