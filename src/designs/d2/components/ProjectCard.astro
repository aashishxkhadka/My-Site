---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

export interface Props {
  project: CollectionEntry<'projects'>;
  /** Resting tilt in degrees; straightens on hover. */
  tilt?: number;
}
const { project, tilt = 0 } = Astro.props;
const { title, tagline, url, basilpotUrl, status, screenshot, screenshotAlt } = project.data;
const statusLabel = { live: 'Live', beta: 'Beta', 'in-development': 'In development', archived: 'Archived' }[status];
const host = url ? new URL(url).host : undefined;
---

<article class="scroll-in group relative" style={`--tilt:${tilt}deg`}>
  <div
    class="frame relative aspect-[16/11] overflow-hidden rounded-[1.75rem] border border-line bg-surface-2 shadow-[0_30px_60px_-30px_rgb(0_0_0/0.35)]"
    style={`--tilt:${tilt}deg`}
  >
    {
      screenshot ? (
        <Image
          src={screenshot}
          alt={screenshotAlt ?? ''}
          widths={[480, 800, 1200]}
          sizes="(min-width: 768px) 50vw, 100vw"
          class="h-full w-full object-cover object-top transition-transform duration-[1.2s] ease-[var(--ease-out-soft)] group-hover:scale-105"
        />
      ) : (
        <div class="relative grid h-full place-items-center overflow-hidden" aria-hidden="true">
          <div class="bg-gradient absolute inset-0 opacity-25 blur-3xl" />
          <span class="display relative px-6 text-center text-step-3 text-ink/40">{title}</span>
        </div>
      )
    }
  </div>
  <div class="mt-6 flex items-start justify-between gap-4 px-1">
    <div>
      <h3 class="display text-step-2">
        {url ? <a href={url} target="_blank" rel="noopener" class="after:absolute after:inset-0">{title}</a> : title}
      </h3>
      <p class="mt-1 text-muted"><slot name="tagline">{tagline}</slot></p>
      <p class="label mt-3 inline-flex items-center gap-1.5">
        <span class:list={['size-1.5 rounded-full', status === 'live' ? 'bg-[#22c55e]' : 'bg-muted']} aria-hidden="true"></span>
        {statusLabel}
      </p>
    </div>
    {
      host && (
        <span class="label mt-2 shrink-0 text-ink" aria-hidden="true">
          {host} <span class="inline-block transition-transform duration-500 ease-[var(--ease-spring)] group-hover:-translate-y-0.5 group-hover:translate-x-0.5">↗</span>
        </span>
      )
    }
  </div>
  {basilpotUrl && <a class="link label relative z-10 mt-2 inline-block px-1" href={basilpotUrl} target="_blank" rel="noopener">On Basilpot ↗</a>}
</article>

<style>
  .frame {
    transform: rotate(var(--tilt));
    transition: transform 900ms var(--ease-spring);
  }
  .group:hover .frame { transform: rotate(0deg) translateY(-6px); }
  @media (prefers-reduced-motion: reduce) {
    .frame, .group:hover .frame { transform: none; transition: none; }
  }
</style>
