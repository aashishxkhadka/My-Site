---
import type { CollectionEntry } from 'astro:content';

export interface Props {
  item: CollectionEntry<'work'>;
  serviceTitles: string[];
}
const { item, serviceTitles } = Astro.props;
const lead = item.data.results[0];
---

<article class="scroll-in group relative isolate grid gap-6 rounded-[2rem] border border-line p-7 transition-colors duration-500 hover:border-transparent md:grid-cols-12 md:items-end md:gap-8 md:p-12">
  <div class="md:col-span-8">
    <p class="label">{item.data.client ?? 'Confidential client'} · {item.data.industry}</p>
    <h3 class="title mt-4 text-step-3">
      <a href={`/work/${item.id}/`} class="after:absolute after:inset-0">{item.data.title}</a>
    </h3>
    <p class="mt-4 max-w-2xl text-muted">{item.data.summary}</p>
    <ul class="mt-6 flex flex-wrap gap-2" aria-label="Services">
      {serviceTitles.map((t) => <li class="rounded-full border border-line px-3 py-1 text-step--1 font-medium">{t}</li>)}
    </ul>
  </div>
  {
    lead && (
      <div class="md:col-span-4 md:text-right">
        <p class="display text-gradient text-step-4">{lead.value}</p>
        <p class="label mt-2">{lead.label}</p>
      </div>
    )
  }
  <span class="bg-gradient pointer-events-none absolute -inset-px -z-10 rounded-[2rem] opacity-0 blur-0 transition-opacity duration-500 group-hover:opacity-100" aria-hidden="true"></span>
  <span class="pointer-events-none absolute inset-0 -z-10 rounded-[2rem] bg-surface" aria-hidden="true"></span>
</article>
