---
import type { CollectionEntry } from 'astro:content';
import { TOPICS } from '@/site.config';
import { formatDate, isoDate } from '@/lib/format';

export interface Props {
  post: CollectionEntry<'blog'>;
}
const { post } = Astro.props;
const topic = TOPICS.find((t) => t.key === post.data.topics[0]);
---

<article class="group relative grid gap-3 border-b border-line py-7 md:grid-cols-12 md:items-baseline md:gap-8">
  <p class="label md:col-span-2"><time datetime={isoDate(post.data.pubDate)}>{formatDate(post.data.pubDate)}</time></p>
  <h3 class="title text-step-2 md:col-span-7">
    <a href={`/blog/${post.id}/`} class="after:absolute after:inset-0 bg-gradient bg-[length:0%_2px] bg-left-bottom bg-no-repeat pb-1 transition-[background-size] duration-700 ease-[var(--ease-out-soft)] group-hover:bg-[length:100%_2px]">{post.data.title}</a>
  </h3>
  {topic && <p class="md:col-span-3 md:text-right"><span class="label rounded-full border border-line px-3 py-1">{topic.label}</span></p>}
</article>
