---
import { NAV, SITE } from '@/site.config';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="glass sticky top-0 z-50 border-x-0 border-t-0">
  <div class="wrap flex h-16 items-center justify-between gap-6">
    <!-- TODO(brand): swap for aashish-khadka-logo.svg once provided. -->
    <a href="/" class="group flex items-center gap-2.5" aria-label={`${SITE.name}, home`}>
      <span class="bg-holo size-6 rotate-45 rounded-[6px] transition-transform duration-700 ease-[var(--ease-spring)] group-hover:rotate-[225deg]" aria-hidden="true"></span>
      <span class="title text-[1.0625rem] uppercase tracking-[0.02em]">Aashish<span class="text-muted">/</span>Khadka</span>
    </a>

    <nav aria-label="Main" class="hidden md:block">
      <ul class="mono flex items-center gap-1">
        {
          NAV.primary.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class="nav-link px-3 py-2 text-muted transition-colors hover:text-ink aria-[current=page]:text-accent"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-1">
      <ThemeToggle />
      <a
        href={NAV.cta.href}
        class="mono hidden items-center gap-2 rounded-full bg-btn-bg px-4 py-2.5 font-semibold text-btn-fg shadow-[var(--glow)] transition-transform hover:-translate-y-0.5 md:inline-flex"
      >
        <span class="size-1.5 animate-pulse rounded-full bg-current motion-reduce:animate-none" aria-hidden="true"></span>
        Connect
      </a>
      <button
        type="button"
        popovertarget="mobile-nav"
        class="mono inline-flex h-10 items-center rounded-full border border-line px-4 md:hidden"
        aria-label="Open menu"
      >
        Menu
      </button>
    </div>
  </div>

  <div id="mobile-nav" popover class="mobile-nav m-0 h-dvh max-h-none w-full max-w-none overflow-hidden bg-bg p-0 text-ink">
    <div class="wrap flex h-16 items-center justify-between border-b border-line">
      <span class="title text-[1.0625rem] uppercase">Aashish<span class="text-muted">/</span>Khadka</span>
      <button type="button" popovertarget="mobile-nav" popovertargetaction="hide" class="mono inline-flex h-10 items-center rounded-full border border-line px-4" aria-label="Close menu">
        Close
      </button>
    </div>
    <nav aria-label="Main mobile" class="wrap pt-8">
      <ul>
        {
          NAV.primary.map((item, i) => (
            <li class="menu-item border-b border-line" style={`--i:${i}`}>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined} class="flex items-baseline justify-between py-4">
                <span class="display text-step-4 aria-[current=page]:text-holo">{item.label}</span>
                <span class="mono text-muted">0{i + 1}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <a href={NAV.cta.href} class="mono mt-8 inline-flex rounded-full bg-btn-bg px-6 py-4 font-semibold text-btn-fg">Connect →</a>
    </nav>
  </div>
</header>

<style>
  .nav-link::before { content: '['; opacity: 0; margin-right: 0.25em; transition: opacity 200ms; }
  .nav-link::after { content: ']'; opacity: 0; margin-left: 0.25em; transition: opacity 200ms; }
  .nav-link:hover::before, .nav-link:hover::after,
  .nav-link[aria-current='page']::before, .nav-link[aria-current='page']::after { opacity: 1; }
  .mobile-nav { inset: 0; border: 0; }
  .mobile-nav::backdrop { background: transparent; }
  @media (prefers-reduced-motion: no-preference) {
    .mobile-nav:popover-open { animation: menu-in 300ms var(--ease-out-soft); }
    .mobile-nav:popover-open .menu-item { animation: item-in 600ms var(--ease-out-soft) both; animation-delay: calc(80ms + var(--i) * 60ms); }
  }
  @keyframes menu-in { from { opacity: 0; } }
  @keyframes item-in { from { opacity: 0; transform: translateX(-30px); } }
</style>
