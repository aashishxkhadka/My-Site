---
/** Product as a "collectible" card: holographic sheen, 3D tilt, mono metadata. */
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

export interface Props {
  project: CollectionEntry<'projects'>;
  index: number;
}
const { project, index } = Astro.props;
const { title, tagline, url, basilpotUrl, status, screenshot, screenshotAlt, schemaType } = project.data;
const statusLabel = { live: 'Live', beta: 'Beta', 'in-development': 'In development', archived: 'Archived' }[status];
const host = url ? new URL(url).host : '—';
const kind = schemaType === 'CreativeWork' ? 'Publication' : 'Web app';
---

<article class="card scroll-in group relative" style="perspective: 1200px" data-flip={index % 2 === 1 ? "" : undefined}>
  <div class="inner glass neon-border relative rounded-[1.75rem] p-3">
    <div class="relative aspect-[16/11] overflow-hidden rounded-[1.25rem] bg-surface-2">
      {
        screenshot ? (
          <Image
            src={screenshot}
            alt={screenshotAlt ?? ''}
            widths={[480, 800, 1200]}
            sizes="(min-width: 768px) 50vw, 100vw"
            class="h-full w-full object-cover object-top"
          />
        ) : (
          <div class="relative grid h-full place-items-center overflow-hidden" aria-hidden="true">
            <div class="bg-holo absolute inset-0 opacity-30 blur-2xl" />
            <span class="display relative px-6 text-center text-step-3">{title}</span>
          </div>
        )
      }
      <!-- holographic sheen -->
      <span class="sheen pointer-events-none absolute inset-0" aria-hidden="true"></span>
      <span class="mono absolute left-3 top-3 rounded-full bg-bg/80 px-2.5 py-1 text-ink backdrop-blur" aria-hidden="true">#{String(index + 1).padStart(3, '0')}</span>
    </div>

    <div class="px-3 pb-3 pt-5">
      <div class="flex items-start justify-between gap-4">
        <h3 class="title text-step-2 uppercase">
          {url ? <a href={url} target="_blank" rel="noopener" class="after:absolute after:inset-0">{title}</a> : title}
        </h3>
        <span class="mono mt-1 text-accent transition-transform duration-500 group-hover:-translate-y-0.5 group-hover:translate-x-0.5" aria-hidden="true">↗</span>
      </div>
      <p class="mt-1 text-muted"><slot name="tagline">{tagline}</slot></p>

      <dl class="mono mt-5 grid grid-cols-[repeat(3,minmax(0,1fr))] gap-px overflow-hidden rounded-xl border border-line bg-line">
        <div class="min-w-0 bg-surface p-3">
          <dt class="text-muted">Status</dt>
          <dd class="mt-1 flex items-center gap-1.5">
            <span class:list={['size-1.5 rounded-full', status === 'live' ? 'bg-[#22c55e]' : 'bg-muted']} aria-hidden="true" />
            {statusLabel}
          </dd>
        </div>
        <div class="min-w-0 bg-surface p-3">
          <dt class="text-muted">Domain</dt>
          <dd class="mt-1 truncate normal-case">{host}</dd>
        </div>
        <div class="min-w-0 bg-surface p-3">
          <dt class="text-muted">Type</dt>
          <dd class="mt-1">{kind}</dd>
        </div>
      </dl>
      {basilpotUrl && <a class="mono link relative z-10 mt-4 inline-block" href={basilpotUrl} target="_blank" rel="noopener">On Basilpot ↗</a>}
    </div>
  </div>
</article>

<style>
  .inner {
    transform-style: preserve-3d;
    transition: transform 700ms var(--ease-spring), box-shadow 700ms;
  }
  .card:hover .inner {
    transform: rotateX(5deg) rotateY(-7deg) translateY(-6px);
    box-shadow: 0 40px 80px -40px color-mix(in oklab, var(--h2) 60%, transparent);
  }
  .card[data-flip]:hover .inner { transform: rotateX(5deg) rotateY(7deg) translateY(-6px); }
  .sheen {
    background: linear-gradient(115deg, transparent 30%, rgb(255 255 255 / 0.35) 45%, color-mix(in oklab, var(--h3) 30%, transparent) 50%, color-mix(in oklab, var(--h1) 30%, transparent) 55%, transparent 70%);
    background-size: 250% 100%;
    background-position: 100% 0;
    mix-blend-mode: overlay;
    opacity: 0;
    transition: opacity 400ms, background-position 1.1s var(--ease-out-soft);
  }
  .card:hover .sheen { opacity: 1; background-position: 0 0; }
  @media (prefers-reduced-motion: reduce) {
    .inner, .card:hover .inner { transform: none; transition: none; }
    .sheen { transition: none; }
  }
</style>
