---
import type { CollectionEntry } from 'astro:content';
import { TOPICS } from '@/site.config';
import { formatDate, isoDate } from '@/lib/format';

export interface Props {
  post: CollectionEntry<'blog'>;
}
const { post } = Astro.props;
const topic = TOPICS.find((t) => t.key === post.data.topics[0]);
---

<article class="group relative grid gap-3 border-b border-line py-6 transition-colors hover:bg-surface/60 md:grid-cols-12 md:items-center md:gap-8 md:px-4">
  <p class="mono text-muted md:col-span-2"><time datetime={isoDate(post.data.pubDate)}>{formatDate(post.data.pubDate)}</time></p>
  <h3 class="text-step-1 font-medium leading-snug md:col-span-7">
    <span class="mono mr-2 text-accent" aria-hidden="true">&gt;</span>
    <a href={`/blog/${post.id}/`} class="after:absolute after:inset-0 group-hover:text-accent">{post.data.title}</a>
    <span class="caret ml-1 inline-block h-[1em] w-[0.5em] translate-y-[0.15em] bg-accent opacity-0 group-hover:opacity-100" aria-hidden="true"></span>
  </h3>
  {topic && <p class="md:col-span-3 md:text-right"><span class="mono rounded-full border border-line px-3 py-1.5 text-muted">#{topic.key}</span></p>}
</article>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .group:hover .caret { animation: blink 1s steps(1) infinite; }
  }
  @keyframes blink { 50% { opacity: 0; } }
</style>
