---
export interface Props {
  href: string;
  variant?: 'primary' | 'glass';
  class?: string;
  [key: string]: unknown;
}

const { href, variant = 'primary', class: className = '', ...rest } = Astro.props;
---

<a
  href={href}
  class:list={[
    'mono group inline-flex items-center gap-3 rounded-full px-6 py-4 font-semibold transition-all duration-300',
    variant === 'primary' ? 'bg-btn-bg text-btn-fg shadow-[var(--glow)] hover:-translate-y-0.5' : 'glass neon-border text-ink',
    className,
  ]}
  {...rest}
>
  <slot />
  <span aria-hidden="true" class="transition-transform duration-500 ease-[var(--ease-spring)] group-hover:translate-x-1">→</span>
</a>
