---
export interface Props {
  id: string;
  kicker?: string;
  title: string;
  lead?: string;
  action?: { label: string; href: string } | undefined;
}
const { id, kicker, title, lead, action } = Astro.props;
---

<div class="scroll-in mb-12 flex flex-col gap-6 md:mb-16 md:flex-row md:items-end md:justify-between">
  <div class="max-w-4xl">
    {kicker && <p class="label mb-5">// {kicker}</p>}
    <h2 id={id} class="display text-step-4">{title}</h2>
    {lead && <p class="mt-6 max-w-xl text-step-1 leading-snug text-muted">{lead}</p>}
  </div>
  {
    action && (
      <a href={action.href} class="mono group inline-flex shrink-0 items-center gap-2 text-ink hover:text-accent">
        [ {action.label} <span aria-hidden="true" class="transition-transform duration-500 group-hover:translate-x-1">→</span> ]
      </a>
    )
  }
</div>
