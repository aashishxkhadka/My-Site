---
/** Iridescent sphere with orbit rings. Decorative, CSS only. */
export interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<div class:list={['orb-wrap pointer-events-none', className]} aria-hidden="true">
  <div class="glow"></div>
  <div class="orb"></div>
  <div class="ring r1"></div>
  <div class="ring r2"></div>
</div>

<style>
  .orb-wrap { position: relative; aspect-ratio: 1; opacity: var(--orb-opacity); }
  .glow {
    position: absolute; inset: 8%;
    border-radius: 50%;
    background: conic-gradient(from 0deg, var(--h1), var(--h2), var(--h3), var(--h4), var(--h1));
    filter: blur(70px);
    opacity: 0.55;
  }
  .orb {
    position: absolute; inset: 18%;
    border-radius: 50%;
    background:
      radial-gradient(circle at 32% 28%, rgb(255 255 255 / 0.95), rgb(255 255 255 / 0) 22%),
      radial-gradient(circle at 70% 75%, rgb(0 0 0 / 0.45), transparent 55%),
      conic-gradient(from 210deg, var(--h1), var(--h2), var(--h3), var(--h4), var(--h1));
    box-shadow: inset -20px -30px 60px rgb(0 0 0 / 0.35), inset 10px 10px 40px rgb(255 255 255 / 0.25);
  }
  .ring {
    position: absolute; inset: 4%;
    border-radius: 50%;
    border: 1px solid color-mix(in oklab, var(--ink) 30%, transparent);
  }
  .r1 { transform: rotateX(72deg) rotateY(12deg); }
  .r2 { inset: 0; transform: rotateX(72deg) rotateY(-24deg); border-style: dashed; opacity: 0.6; }

  @media (prefers-reduced-motion: no-preference) {
    .orb { animation: orb-hue 12s linear infinite; }
    .glow { animation: glow-hue 12s linear infinite reverse; }
    .orb-wrap { animation: float 7s ease-in-out infinite; }
    .r1 { animation: ring-a 14s linear infinite; }
    .r2 { animation: ring-b 22s linear infinite; }
  }
  @keyframes orb-hue { to { filter: hue-rotate(360deg); } }
  @keyframes glow-hue { from { filter: blur(70px) hue-rotate(0deg); } to { filter: blur(70px) hue-rotate(360deg); } }
  @keyframes float { 50% { transform: translateY(-14px); } }
  @keyframes ring-a { to { transform: rotateX(72deg) rotateY(12deg) rotateZ(360deg); } }
  @keyframes ring-b { to { transform: rotateX(72deg) rotateY(-24deg) rotateZ(-360deg); } }
</style>
