---
/** Neon perspective grid running to the horizon. Decorative, CSS only. */
export interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<div class:list={['floor pointer-events-none absolute inset-x-0 bottom-0 -z-10 h-[55%] overflow-hidden', className]} aria-hidden="true">
  <div class="plane"></div>
  <div class="horizon"></div>
</div>

<style>
  .floor { perspective: 360px; mask-image: linear-gradient(to top, #000 30%, transparent 95%); }
  .plane {
    position: absolute; left: -50%; right: -50%; top: 0; height: 200%;
    transform-origin: 50% 0;
    transform: rotateX(62deg);
    background-image:
      linear-gradient(var(--grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size: 56px 56px;
  }
  .horizon {
    position: absolute; left: 0; right: 0; top: 0; height: 2px;
    background: linear-gradient(90deg, transparent, var(--h2), var(--h3), var(--h1), transparent);
    box-shadow: 0 0 24px 4px color-mix(in oklab, var(--h2) 60%, transparent);
  }
  @media (prefers-reduced-motion: no-preference) {
    .plane { animation: travel 2.4s linear infinite; }
  }
  @keyframes travel { to { background-position: 0 56px, 0 0; } }
</style>
