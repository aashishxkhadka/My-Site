---
import './global.css';
import { Font } from 'astro:assets';
import BaseHead, { type Props as HeadProps } from '@/layouts/BaseHead.astro';
import BodyEnd from '@/layouts/BodyEnd.astro';
import Breadcrumbs from '@/components/seo/Breadcrumbs.astro';
import Header from './components/Header.astro';
import Footer from './components/Footer.astro';
import { withHome } from '@/lib/crumbs';
import type { Crumb } from '@/lib/schema';

export type Props = Omit<HeadProps, 'crumbs' | 'themeColor'> & {
  /** Trail after Home. Renders visible breadcrumbs + BreadcrumbList. */
  breadcrumbs?: Crumb[];
};

const { breadcrumbs, ...head } = Astro.props;
const crumbs = withHome(breadcrumbs);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead {...head} crumbs={crumbs} themeColor={{ light: '#f3f2fb', dark: '#06060b' }} />
    <Font cssVariable="--d3-display" preload />
    <Font cssVariable="--d3-sans" preload />
    <Font cssVariable="--d3-mono" />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[200] focus:rounded-full focus:bg-ink focus:px-4 focus:py-2 focus:text-bg"
      >Skip to content</a
    >
    <Header />
    <main id="main" class="flex-1 focus:outline-none" tabindex="-1">
      {crumbs && <div class="wrap pt-8"><Breadcrumbs crumbs={crumbs} /></div>}
      <slot />
    </main>
    <Footer />
    <BodyEnd />
  </body>
</html>
